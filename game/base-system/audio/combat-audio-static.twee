:: Audio Combat Static [widget]
/* Combat/sex sound playlists, ported from X-Change init-playlist. BGM stays in GameAudio. */

<<widget "audioInit">>
	<<run Config.audio.preloadMetadata = false>>
	<<set setup.initializedPlaylists to setup.initializedPlaylists || []>>
	<<set setup.playlists to setup.playlists || {}>>
<</widget>>

<<widget "init-playlist">>
	<<if setup.playlists is undefined>>
		<<set setup.playlists to {}>>
	<</if>>
	<<if setup.initializedPlaylists is undefined>>
		<<set setup.initializedPlaylists to []>>
	<</if>>
	<<if setup.initializedPlaylists.includes(_args[0])>>
		<<exit>>
	<</if>>
	<<switch _args[0]>>
            <<case "v1_breath_vvslow">>
                <<cacheaudio "v1_breath_vslow1" "audio/bgv/f_voice1/normal/breath/breath-veryslow-01.mp3">>
                <<cacheaudio "v1_breath_vslow2" "audio/bgv/f_voice1/normal/breath/breath-veryslow-02.mp3">>
                    <<createplaylist "v1_breath_vvslow">>
                        <<track "v1_breath_vslow1" volume 0.8>>
                        <<track "v1_breath_vslow2" volume 0.8>>
                    <</createplaylist>>
            <<case "v2_breath_vvslow">>
                <<cacheaudio "v2_breath_vslow1" "audio/bgv/f_voice2/normal/breath/breath-veryslow-01.mp3">>
                <<cacheaudio "v2_breath_vslow2" "audio/bgv/f_voice2/normal/breath/breath-veryslow-02.mp3">>
                    <<createplaylist "v2_breath_vvslow">>
                        <<track "v2_breath_vslow1" volume 0.8>>
                        <<track "v2_breath_vslow2" volume 0.8>>
                    <</createplaylist>>
            <<case "v2_gagged_breath_vvslow">>
                <<cacheaudio "v2_gagged_breath_vslow1" "audio/bgv/f_voice2/gagged/breath/breath-veryslow-01.mp3">>
                <<cacheaudio "v2_gagged_breath_vslow2" "audio/bgv/f_voice2/gagged/breath/breath-veryslow-02.mp3">>
                    <<createplaylist "v2_gagged_breath_vvslow">>
                        <<track "v2_gagged_breath_vslow1" volume 0.8>>
                        <<track "v2_gagged_breath_vslow2" volume 0.8>>
                    <</createplaylist>>
            <<case "v2_noncon_breath_vvslow">>
                <<cacheaudio "v2_noncon_breath_vslow1" "audio/bgv/f_voice2/noncon/breath/breath-veryslow-01.mp3">>
                <<cacheaudio "v2_noncon_breath_vslow2" "audio/bgv/f_voice2/noncon/breath/breath-veryslow-02.mp3">>
                    <<createplaylist "v2_noncon_breath_vvslow">>
                        <<track "v2_noncon_breath_vslow1" volume 0.8>>
                        <<track "v2_noncon_breath_vslow2" volume 0.8>>
                    <</createplaylist>>
            <!------------------------------------------------------------>
            <<case "v1_breath_vslow">>
                <<cacheaudio "v1_breath_vslow1" "audio/bgv/f_voice1/normal/breath/breath-veryslow-01.mp3">>
