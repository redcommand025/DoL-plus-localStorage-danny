                        "v2_gagged_orgasm2",
                        "v2_gagged_orgasm3",
                        "v2_gagged_orgasm4",
                        "v2_gagged_orgasm5",
                        "v2_gagged_orgasm6"
                    ]>>
            <<case "v2_noncon_orgasm">>
                <<cacheaudio "v2_noncon_orgasm1" "audio/ve/f_voice2/noncon/orgasm/orgasm-01.mp3">>
                <<cacheaudio "v2_noncon_orgasm2" "audio/ve/f_voice2/noncon/orgasm/orgasm-02.mp3">>
                <<cacheaudio "v2_noncon_orgasm3" "audio/ve/f_voice2/noncon/orgasm/orgasm-03.mp3">>
                <<cacheaudio "v2_noncon_orgasm4" "audio/ve/f_voice2/noncon/orgasm/orgasm-04.mp3">>
                <<cacheaudio "v2_noncon_orgasm5" "audio/ve/f_voice2/noncon/orgasm/orgasm-05.mp3">>
                <<cacheaudio "v2_noncon_orgasm6" "audio/ve/f_voice2/noncon/orgasm/orgasm-06.mp3">>
                    <<set setup.playlists.v2_noncon_orgasm to [
                        "v2_noncon_orgasm1",
                        "v2_noncon_orgasm2",
                        "v2_noncon_orgasm3",
                        "v2_noncon_orgasm4",
                        "v2_noncon_orgasm5",
                        "v2_noncon_orgasm6"
                    ]>>
            <!------------------------------------------------------------>
            <<case "m_orgasm">>
                <<cacheaudio "m_orgasm1" "audio/ve/m_voice1/orgasm/orgasm-01.mp3">>
                <<cacheaudio "m_orgasm2" "audio/ve/m_voice1/orgasm/orgasm-02.mp3">>
                <<cacheaudio "m_orgasm3" "audio/ve/m_voice1/orgasm/orgasm-03.mp3">>
                    <<set setup.playlists.m_orgasm to [
                        "m_orgasm1",
                        "m_orgasm2",
                        "m_orgasm3"
                    ]>>
            <!------------------------------------------------------------>
            <<case "npc_f">>
                <<cacheaudio "npc_f1" "audio/ve/npc_f/orgasm/orgasm-01.mp3">>
                <<cacheaudio "npc_f2" "audio/ve/npc_f/orgasm/orgasm-02.mp3">>
                <<cacheaudio "npc_f3" "audio/ve/npc_f/orgasm/orgasm-03.mp3">>
                <<cacheaudio "npc_f4" "audio/ve/npc_f/orgasm/orgasm-04.mp3">>
                <<cacheaudio "npc_f5" "audio/ve/npc_f/orgasm/orgasm-05.mp3">>
                <<cacheaudio "npc_f6" "audio/ve/npc_f/orgasm/orgasm-06.mp3">>
                <<cacheaudio "npc_f7" "audio/ve/npc_f/orgasm/orgasm-07.mp3">>
                <<cacheaudio "npc_f8" "audio/ve/npc_f/orgasm/orgasm-08.mp3">>
                <<cacheaudio "npc_f9" "audio/ve/npc_f/orgasm/orgasm-09.mp3">>
                <<cacheaudio "npc_f10" "audio/ve/npc_f/orgasm/orgasm-10.mp3">>
                <<cacheaudio "npc_f11" "audio/ve/npc_f/orgasm/orgasm-11.mp3">>
                    <<set setup.playlists.npc_f to [
                        "npc_f1",
                        "npc_f2",
                        "npc_f3",
                        "npc_f4",
                        "npc_f5",
                        "npc_f6",
                        "npc_f7",
                        "npc_f8",
                        "npc_f9",
                        "npc_f10",
                        "npc_f11"
                    ]>>
            <!------------------------------------------------------------>
            <<case "npc_m">>
                <<cacheaudio "npc_m1" "audio/ve/npc_m/orgasm/orgasm-01.mp3">>
                <<cacheaudio "npc_m2" "audio/ve/npc_m/orgasm/orgasm-02.mp3">>
                <<cacheaudio "npc_m3" "audio/ve/npc_m/orgasm/orgasm-03.mp3">>
                <<cacheaudio "npc_m4" "audio/ve/npc_m/orgasm/orgasm-04.mp3">>
                    <<set setup.playlists.npc_m to [
                        "npc_m1",
                        "npc_m2",
                        "npc_m3",
                        "npc_m4"
                    ]>>
        <</switch>>

        /* One-time AudioList prototype patch: stale autoplay-unlock handlers must not play destroyed lists */
        <<run guardAudioListPrototype(_args[0])>>

        <<run setup.initializedPlaylists.pushUnique(_args[0])>>

    <</widget>>
