					<<set $milk_max to 3000>>
					<<run $timeMessages.pushUnique("sheepDown5")>>
					<<set $sheep to 5>>
					<<set $transformationParts.sheep.tail to "disabled">>
					<<set $hastail to "false">>
					<<set $thintail to "false">>
					<br><br>
					<<set $permanentTransform to 1>>
				<</if>>
			<<case 99>>
