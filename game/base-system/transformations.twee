:: Transformation Widgets [widget]

<<widget "setupTransformationPiecesObject">>
	<<if $transformationParts is undefined>>
		<<set $transformationParts to {
			traits: {fangs:"disabled", sharpEyes:"disabled", dragonEyes:"disabled", mateForLife:"disabled", chase:"disabled", flaunting:"disabled", preyAnimal:"disabled", strongFeet:"disabled", predatoryAnimal:"disabled", tempTolerance:"disabled", aquatic:"disabled", wdgrace:"disabled", incognito:"disabled", aquatail:"disabled", lungs:"disabled", vigorous:"disabled", webbedfeet:"disabled", strongnose:"disabled", longtongue:"disabled", kicks:"disabled", activeTF:"disabled", activeTFOverride:false},
			angel: {halo:"disabled", wings:"disabled"},
			fallenAngel: {halo:"disabled", wings:"disabled"},
			demon: {horns:"disabled", wings:"disabled", tail: "disabled"},
			cat: {ears:"disabled", tail:"disabled", heterochromia:"disabled"},
			cow: {horns:"disabled", ears:"disabled", tail:"disabled"},
			wolf: {ears:"disabled", tail:"disabled", pubes:"disabled", pits:"disabled", cheeks:"disabled"},
			bird: {tail:"disabled", wings:"disabled", eyes:"disabled", malar:"disabled", plumage:"disabled", pubes:"disabled"},
			fox: {ears:"disabled", tail:"disabled", cheeks:"disabled"},
			bee: {ears:"disabled", tail:"disabled", wings:"disabled"},
			sheep: {ears:"disabled", tail:"disabled", horns:"disabled"},
			deer: {ears:"disabled", tail:"disabled", horns:"disabled"},
			bear: {plumage:"disabled", pubes:"disabled", ears:"disabled", tail:"disabled"},
			dragon: {tail:"disabled", wings:"disabled", eyes:"disabled", horns:"disabled", claws:"disabled", whisker:"disabled", fangs:"disabled"},
			lizard: {horns:"disabled", tail:"disabled", eyes:"disabled"},
			dolphin: {tail:"disabled"},
			dog: {ears:"disabled", tail:"disabled"},
			ghost: {eyes:"disabled", hitodama:"disabled", mist:"disabled"},
			slime: {bubble:"disabled", stream:"disabled", core:"disabled"},
			mushroom: {cap:"disabled", eyes:"disabled", spores:"disabled", mushrooms:"disabled"},
			raccoon: {mask:"disabled", ears: "disabled", tail: "disabled"},
			fish: {fins:"disabled", tail:"disabled"},
			horse: {ears:"disabled", tail:"disabled"},
			frog: {eyes:"disabled", cheeks: "disabled"},
			spider: {eyes:"disabled", tail:"disabled"},
			pig: {ears:"disabled", tail:"disabled"},
			bunny: {ears:"disabled", tail:"disabled"},
			okami: {ears:"disabled", tail:"disabled", wings:"disabled", misc:"disabled"},
			seraphim: {wings:"disabled", plumage:"disabled", eyes:"disabled"},
			kitsune: {ears:"disabled", tail:"disabled", cheeks:"disabled", misc:"disabled"},
			waterdragon: {horns:"disabled", ears:"disabled", tail:"disabled"},
			goblin: {ears:"disabled"},
			eldritch: {skin:"disabled", tentacle:"disabled", eyes:"disabled", mist:"disabled"},
			fae: {wings:"disabled", fairies:"disabled"},
		}>>
		<<if $specialTransform is 1>>
			<<if $angel gte 4>>
				<<set V.transformationParts.angel.halo to "default">>
			<</if>>
			<<if $angel gte 6>>
				<<set V.transformationParts.angel.wings to "default">>
				<<set $angeltf to 1>>
			<</if>>
			<<if $fallenangel gte 2>>
				<<set V.transformationParts.fallenAngel.halo to "default">>
				<<set V.transformationParts.fallenAngel.wings to "default">>
				<<set $fallenangeltf to 1>>
			<</if>>
			<<if $demon gte 2>>
				<<set V.transformationParts.demon.horns to "default">>
			<</if>>
			<<if $demon gte 4>>
				<<set V.transformationParts.demon.tail to "default">>
				<<set $hastail to "true">>
				<<set $thintail to "true">>
			<</if>>
			<<if $demon gte 6>>
				<<set V.transformationParts.demon.wings to "default">>
				<<set $demontf to 1>>
			<</if>>
		<</if>>
		<<if $physicalTransform is 1>>
			<<if $wolfgirl gte 2>>
				<<set V.transformationParts.traits.fangs to "default">>
			<</if>>
			<<if $wolfgirl gte 4>>
				<<set V.transformationParts.wolf.ears to "default">>
				<<set V.transformationParts.wolf.pubes to "default">>
				<<set V.transformationParts.wolf.pits to "default">>
			<</if>>
			<<if $wolfgirl gte 6>>
				<<set V.transformationParts.wolf.tail to "default">>
				<<set $hastail to "true">>
				<<set $thintail to "true">>
			<</if>>
			<<if $cat gte 2>>
				<<set V.transformationParts.traits.fangs to "default">>
			<</if>>
			<<if $cat gte 4>>
				<<set V.transformationParts.cat.ears to "default">>
			<</if>>
			<<if $cat gte 6>>
				<<set V.transformationParts.cat.tail to "default">>
				<<set $hastail to "true">>
				<<set $thintail to "true">>
			<</if>>
			<<if $cat gte 7>>
				<<set V.transformationParts.cat.heterochromia to "default">>
			<</if>>
			<<if $cow gte 2>>
				<<set V.transformationParts.cow.horns to "default">>
			<</if>>
			<<if $cow gte 4>>
				<<set V.transformationParts.cow.ears to "default">>
			<</if>>
			<<if $cow gte 6>>
				<<set V.transformationParts.cow.tail to "default">>
				<<set $hastail to "true">>
				<<set $thintail to "true">>
			<</if>>
			<<if $bee gte 2>>
				<<set $transformationParts.bee.ears to "default">>
			<</if>>
			<<if $bee gte 4>>
				<<set $transformationParts.bee.tail to "default">>
				<<set $hastail to "true">>
				<<set $thicktail to "true">>
			<</if>>
			<<if $bee gte 6>>
				<<set $transformationParts.bee.wings to "default">>
			<</if>>
			<<if $raccoon gte 2>>
				<<set $transformationParts.traits.incognito to "default">>
				<<set $transformationParts.traits.sharpEyes to "default">>
			<</if>>
			<<if $raccoon gte 4>>
				<<set $transformationParts.raccoon.ears to "default">>
			<</if>>
			<<if $raccoon gte 6>>
				<<set $transformationParts.raccoon.tail to "default">>
				<<set $hastail to "true">>
				<<set $thintail to "true">>
			<</if>>
			<<if $sheep gte 2>>
				<<set $transformationParts.sheep.horns to "default">>
			<</if>>
			<<if $sheep gte 4>>
				<<set $transformationParts.sheep.ears to "default">>
			<</if>>
			<<if $sheep gte 6>>
				<<set $transformationParts.sheep.tail to "default">>
				<<set $hastail to "true">>
				<<set $thintail to "true">>
			<</if>>
			<<if $deer gte 2>>
				<<set $transformationParts.deer.horns to "default">>
			<</if>>
			<<if $deer gte 4>>
				<<set $transformationParts.deer.ears to "default">>
			<</if>>
			<<if $deer gte 6>>
				<<set $transformationParts.deer.tail to "default">>
				<<set $transformationParts.traits.kicks to "default">>
				<<set $hastail to "true">>
				<<set $thintail to "true">>
			<</if>>
			<<if $bear gte 2>>
				<<set $transformationParts.traits.fangs to "default">>
				<<set $transformationParts.traits.strongnose to "default">>
			<</if>>
			<<if $bear gte 4>>
				<<set $transformationParts.bear.ears to "default">>
			<</if>>
			<<if $bear gte 6>>
				<<set $transformationParts.bear.tail to "default">>
				<<set $hastail to "true">>
				<<set $thintail to "true">>
			<</if>>
			<<if $dragon gte 1>>
				<<set $transformationParts.dragon.eyes to "default">>
			<</if>>
			<<if $dragon gte 2>>
				<<set $transformationParts.dragon.fangs to "default">>
			<</if>>
			<<if $dragon gte 3>>
				<<set $transformationParts.dragon.horns to "default">>
			<</if>>
			<<if $dragon gte 4>>
				<<set $transformationParts.dragon.tail to "default">>
				<<set $hastail to "true">>
				<<set $thicktail to "true">>
			<</if>>
			<<if $transformationParts.dragon.wings isnot "disabled">>
				<<set $transformationParts.dragon.wings to "default">>
			<</if>>
			<<if $lizard gte 1>>
				<<set $transformationParts.lizard.eyes to "default">>
			<</if>>
			<<if $lizard gte 2>>
				<<set $transformationParts.traits.fangs to "default">>
			<</if>>
			<<if $lizard gte 6>>
				<<set $transformationParts.lizard.tail to "default">>
				<<set $hastail to "true">>
				<<set $thicktail to "true">>
				<<set $transformationParts.traits.aquatail to "default">>
				<<set $transformationParts.traits.lungs to "default">>
			<</if>>
			<<if $dolphin gte 2>>
				<<set $transformationParts.traits.lungs to "default">>
			<</if>>
			<<if $dolphin gte 4>>
				<<set $transformationParts.dolphin.tail to "default">>
				<<set $hastail to "true">>
				<<set $thicktail to "true">>
				<<set $swimtail to "true">>
			<</if>>
			<<if $dolphin gte 6>>
				<<set $transformationParts.traits.aquatail to "default">>
			<</if>>
			<<if $dog gte 2>>
				<<set $transformationParts.traits.fangs to "default">>
			<</if>>
			<<if $dog gte 4>>
				<<set $transformationParts.dog.ears to "default">>
			<</if>>
			<<if $dog gte 6>>
				<<set $transformationParts.dog.tail to "default">>
				<<set $hastail to "true">>
				<<set $thintail to "true">>
			<</if>>
			<<if $fish gte 2>>
				<<set $transformationParts.traits.aquatic to "default">>
			<</if>>
			<<if $fish gte 4>>
				<<set $transformationParts.fish.fins to "default">>
			<</if>>
			<<if $fish gte 6>>
				<<set $transformationParts.fish.tail to "default">>
				<<set $transformationParts.traits.aquatail to "default">>
				<<set $hastail to "true">>
				<<set $thicktail to "true">>
				<<set $swimtail to "true">>
			<</if>>
			<<if $horse gte 2>>
				<<set $transformationParts.traits.vigorous to "default">>
			<</if>>
			<<if $horse gte 4>>
				<<set $transformationParts.horse.ears to "default">>
			<</if>>
			<<if $horse gte 6>>
				<<set $transformationParts.horse.tail to "default">>
				<<set $transformationParts.traits.kicks to "default">>
				<<set $hastail to "true">>
				<<set $thintail to "true">>
			<</if>>
			<<if $frog gte 2>>
				<<set $transformationParts.traits.kicks to "default">>
				<<set $transformationParts.traits.lungs to "default">>
				<<set $transformationParts.traits.longtongue to "default">>
				<<set $transformationParts.traits.webbedfeet to "default">>
			<</if>>
			<<if $frog gte 4>>
				<<set $transformationParts.frog.eyes to "default">>
			<</if>>
			<<if $frog gte 6>>
				<<set $transformationParts.frog.cheeks to "default">>
			<</if>>
			<<if $spider gte 2>>
				<<set $transformationParts.traits.fangs to "default">>
			<</if>>
			<<if $spider gte 4>>
				<<set $transformationParts.spider.eyes to "default">>
				<<set $transformationParts.traits.sharpEyes to "default">>
			<</if>>
			<<if $spider gte 6>>
				<<set $transformationParts.spider.tail to "default">>
				<<set $hastail to "true">>
				<<set $thicktail to "true">>
			<</if>>
			<<if $pig gte 2>>
				<<set $transformationParts.traits.strongnose to "default">>
			<</if>>
			<<if $pig gte 4>>
				<<set $transformationParts.pig.ears to "default">>
			<</if>>
			<<if $pig gte 6>>
				<<set $transformationParts.pig.tail to "default">>
				<<set $hastail to "true">>
				<<set $thintail to "true">>
			<</if>>

			<<if $bunny gte 4>>
				<<set $transformationParts.bunny.ears to "default">>
			<</if>>
			<<if $bunny gte 6>>
				<<set $transformationParts.bunny.tail to "default">>
				<<set $hastail to "true">>
				<<set $thintail to "true">>
			<</if>>
			<<if $waterdragon gte 2 or ($transformationParts.waterdragon.horns is "default")>>
				<<set $transformationParts.waterdragon.horns to "default">>
			<</if>>
			<<if $waterdragon gte 4>>
				<<set $transformationParts.waterdragon.ears to "default">>
			<</if>>
			<<if $waterdragon gte 7>>
				<<set $transformationParts.waterdragon.tail to "default">>
				<<set $hastail to "true">>
				<<set $thicktail to "true">>
			<</if>>
		<</if>>
	<</if>>
	<<if V.transformationParts.fallenAngel.halo is 1>>
		<<set V.transformationParts.fallenAngel.halo to "default">>
		<<set V.transformationParts.fallenAngel.wings to "default">>
	<</if>>
	<<if V.transformationParts.demon.horns is 1>>
		<<set V.transformationParts.demon.horns to "default">>
		<<set V.transformationParts.demon.tail to "default">>
		<<set V.transformationParts.demon.wings to "default">>
	<</if>>
	<<if $angel lt 4>>
		<<set V.transformationParts.angel.halo to "disabled">>
	<</if>>
	<<if $angel lt 6>>
		<<set V.transformationParts.angel.wings to "disabled">>
	<</if>>
	<<if $fallenangel is 1>>
		<<set V.transformationParts.fallenAngel.halo to "disabled">>
		<<set V.transformationParts.fallenAngel.wings to "disabled">>
	<</if>>
	<<if $transformationParts.wolf.cheeks is undefined>>
		<<if $wolfgirl gte 5>>
			<<set $transformationParts.wolf.cheeks to "feral">>
		<<else>>
			<<set V.transformationParts.wolf.cheeks to "disabled">>
		<</if>>
	<</if>>
	<<if V.transformationParts.bird is undefined>>
		<<set V.transformationParts.bird to {tail:"disabled", wings:"disabled", eyes:"disabled", malar:"disabled", plumage:"disabled"}>>
	<</if>>
	<<if V.transformationParts.bird.pubes is undefined>>
		<<if $harpy gte 6>>
			<<set V.transformationParts.bird.pubes to "hidden">>
		<<else>>
			<<set V.transformationParts.bird.pubes to "disabled">>
		<</if>>
	<</if>>
	<<if V.transformationParts.fox is undefined>>
		<<set V.transformationParts.fox to {ears:"disabled", tail:"disabled", cheeks:"disabled"}>>
	<</if>>
	<<if V.transformationParts.traits is undefined>>
		<<set V.transformationParts.traits to {fangs:"disabled", sharpEyes:"disabled", mateForLife:"disabled", chase:"disabled", flaunting:"disabled"}>>
		<<if $transformationParts.dragon is undefined>>
			<<set $transformationParts.dragon to {tail:"disabled", wings:"disabled", eyes:"disabled", fangs:"disabled", horns:"disabled",whisker:"disabled"}>>
		<</if>>
	<</if>>	
	<<if $transformationParts.lizard is undefined>>
		<<set $transformationParts.lizard to {tail:"disabled", eyes:"disabled"}>>
	<</if>>
	<<if $transformationParts.dolphin is undefined>>
		<<set $transformationParts.dolphin to {tail:"disabled"}>>
	<</if>>
	<<if $transformationParts.raccoon is undefined>>
		<<set $transformationParts.raccoon to {ears:"disabled", tail:"disabled", mask:"disabled"}>>
	<</if>>
	<<if $transformationParts.fish is undefined>>
		<<set $transformationParts.fish to {fins:"disabled", tail:"disabled"}>>
	<</if>>
	<<if $transformationParts.horse is undefined>>
		<<set $transformationParts.horse to {ears:"disabled", tail:"disabled"}>>
	<</if>>
	<<if $transformationParts.spider is undefined>>
		<<set $transformationParts.spider to {eyes:"disabled", tail:"disabled"}>>
	<</if>>
	<<if $transformationParts.frog is undefined>>
		<<set $transformationParts.frog to {cheeks:"disabled", eyes:"disabled"}>>
	<</if>>
	<<if $transformationParts.pig is undefined>>
		<<set $transformationParts.pig to {ears:"disabled", tail:"disabled"}>>
	<</if>>
	<<if $transformationParts.bunny is undefined>>
		<<set $transformationParts.bunny to {ears:"disabled", tail:"disabled"}>>
	<</if>>
	<<if $transformationParts.dog is undefined>>
		<<set $transformationParts.dog to {tail:"disabled", ears:"disabled"}>>
	<</if>>
	<<if $transformationParts.wolf.pubes is undefined>>
		<<set $transformationParts.wolf to {ears:"disabled", tail:"disabled", pubes:"disabled", pits:"disabled"}>>
	<</if>>
	<<if $transformationParts.ghost is undefined>>
		<<set $transformationParts.ghost to {eyes:"disabled", hitodama:"disabled", mist:"disabled", stream:"disabled", flame:"disabled"}>>
	<</if>>
	<<if $transformationParts.slime is undefined>>
		<<set $transformationParts.slime to {bubble:"disabled", stream:"disabled", core:"disabled"}>>
	<</if>>
	<<if $transformationParts.mushroom is undefined>>
		<<set $transformationParts.mushroom to {cap:"disabled", eyes:"disabled", spores:"disabled", mushrooms:"disabled"}>>
	<</if>>
	<<if $transformationParts.traits is undefined>>
		<<set $transformationParts.traits to {fangs:"disabled", sharpEyes:"disabled", mateForLife:"disabled", flaunting:"disabled", lungs:"disabled", aquatail:"disabled", incognito:"disabled", aquatic:"disabled", vigorous:"disabled", webbedfeet:"disabled", strongnose:"disabled", longtongue:"disabled", kicks:"disabled"}>>
		<<if $wolfgirl gte 2 or $cat gte 2 or $fox gte 2>>
			<<set V.transformationParts.traits.fangs to "default">>
		<</if>>
		<<if $cat gte 2 or $harpy gte 2 or $fox gte 2>>
			<<set V.transformationParts.traits.sharpEyes to "default">>
		<</if>>
	<</if>>

	<<if $transformationParts.okami is undefined>>
		<<set $transformationParts.okami to {ears:"disabled", tail:"disabled", wings:"disabled", misc:"disabled"}>>
	<</if>>
	<<if $transformationParts.seraphim is undefined>>
		<<set $transformationParts.seraphim to {wings:"disabled", plumage:"disabled", eyes:"disabled"}>>
	<</if>>
	<<if $transformationParts.kitsune is undefined>>
		<<set $transformationParts.kitsune to {ears:"disabled", tail:"disabled", cheeks:"disabled", misc:"disabled"}>>
	<</if>>
	<<if $transformationParts.waterdragon is undefined>>
		<<set $transformationParts.waterdragon to {horns:"disabled", ears:"disabled", tail:"disabled"}>>
	<</if>>
	<<if $transformationParts.bear is undefined>>
		<<set $transformationParts.bear to {plumage:"disabled", pubes:"disabled", ears:"disabled", tail:"disabled"}>>
	<</if>>
	<<if $transformationParts.bear.plumage is undefined>>
		<<set $transformationParts.bear.plumage to "disabled">>
	<</if>>
	<<if $transformationParts.bear.pubes is undefined>>
		<<set $transformationParts.bear.pubes to "disabled">>
	<</if>>
	<<if $transformationParts.traits.activeTF is undefined>>
		<<set $transformationParts.traits.activeTF to "disabled">>
	<</if>>
	<<if $transformationParts.traits.activeTFOverride is undefined>>
		<<set $transformationParts.traits.activeTFOverride to false>>
	<</if>>

	<<if $transformationParts.goblin is undefined>>
		<<set $transformationParts.goblin to {ears:"disabled"}>>
	<</if>>
	<<if $transformationParts.eldritch is undefined>>
		<<set $transformationParts.eldritch to {skin:"disabled", tentacle:"disabled", eyes:"disabled", mist:"disabled"}>>
	<</if>>
	<<if $transformationParts.fae is undefined>>
		<<set $transformationParts.fae to {wings:"disabled", fairies:"disabled"}>>
	<</if>>
	/* Setup chimera's config */
	<<set _defaultChimeraConfig to {
		demoncat: {
			tail: true
		},
		demoncow: {
			tail: true,
			horns: true,
		},
		demonwolf: {
			tail: true
		},
		demonfox: {
			tail: true,
			ears: true
		},
		demonharpy: {
			wings: true
		},
		angelharpy: {
			wings: true
		},
		fallenharpy: {
			wings: true
		},
	}>>
	/* Convert chimera obj back to an object if it was something else. Necessary for object.assign next. */
	<<if typeof $chimera !== 'object'>>
		<<set $chimera to {}>>
	<</if>>
	/* Takes default object and transposes chimera config ontop of it, assigning the result to chimera config. */
	<<set $chimera = Object.keys(_defaultChimeraConfig).reduce((acc, key) => {
		acc[key] = Object.assign({}, _defaultChimeraConfig[key], $chimera[key] || {});
		return acc;
	}, {})>>
<</widget>>

<<widget "transform">>/*First arg is transformation, second is the intensity of change.*/
	<<if $physicalTransform is 1 or $specialTransform is 1>>
		<<set $permanentTransform to 1>>
	<</if>>
	<<if _args[1]>>
		<<if $featsBoosts.upgrades.adaptiveGenes gte 1 and _args[1] gte 1>>
			<<set _args[1] to _args[1] * ($featsBoosts.upgrades.adaptiveGenes + 50) / 50>>
		<</if>>
		<<switch _args[0]>>
			<<case "wolf">>  <<set $wolfbuild  = Math.clamp($wolfbuild  + _args[1], 0, 100)>>
			<<case "cat">>   <<set $catbuild   = Math.clamp($catbuild   + _args[1], 0, 100)>>
			<<case "cow">>   <<set $cowbuild   = Math.clamp($cowbuild   + _args[1], 0, 100)>>
			<<case "bird">>  <<set $birdbuild  = Math.clamp($birdbuild  + _args[1], 0, 100)>>
			<<case "fox">>   <<set $foxbuild   = Math.clamp($foxbuild   + _args[1], 0, 100)>>
			<<case "angel">> <<set $angelbuild = Math.clamp($angelbuild + _args[1], 0, 100)>>
			<<case "fallen">> <<set $fallenbuild = Math.clamp($fallenbuild + _args[1], 0, 100)>>
			<<case "demon">> <<set $demonbuild = Math.clamp($demonbuild + _args[1], 0, 100)>>
			<<case "bee">> <<set $beebuild = Math.clamp($beebuild + _args[1], 0, 100)>>
			<<case "sheep">> <<set $sheepbuild = Math.clamp($sheepbuild + _args[1], 0, 100)>>
			<<case "deer">> <<set $deerbuild = Math.clamp($deerbuild + _args[1], 0, 100)>>
			<<case "bear">> <<set $bearbuild = Math.clamp($bearbuild + _args[1], 0, 100)>>
			<<case "bunny">> <<set $bunnybuild = Math.clamp($bunnybuild + _args[1], 0, 100)>>
			<<case "waterdragon">> <<set $waterdragonbuild = Math.clamp($waterdragonbuild + _args[1], 0, 100)>>
			<<case "dragon">> <<set $dragonbuild = Math.clamp($dragonbuild + _args[1], 0, 100)>>
			<<case "lizard">> <<set $lizardbuild = Math.clamp($lizardbuild + _args[1], 0, 100)>>
			<<case "dolphin">> <<set $dolphinbuild = Math.clamp($dolphinbuild + _args[1], 0, 100)>>
			<<case "dog">> <<set $dogbuild = Math.clamp($dogbuild + _args[1], 0, 100)>>
			<<case "raccoon">> <<set $raccoonbuild = Math.clamp($raccoonbuild + _args[1], 0, 100)>>
			<<case "fish">> <<set $fishbuild = Math.clamp($fishbuild + _args[1], 0, 100)>>
			<<case "horse">> <<set $horsebuild = Math.clamp($horsebuild + _args[1], 0, 100)>>
			<<case "spider">> <<set $spiderbuild = Math.clamp($spiderbuild + _args[1], 0, 100)>>
			<<case "frog">> <<set $frogbuild = Math.clamp($frogbuild + _args[1], 0, 100)>>
			<<case "pig">> <<set $pigbuild = Math.clamp($pigbuild + _args[1], 0, 100)>>
		<</switch>>
	<</if>>
	<<if !["angel", "fallen", "demon"].includes(_args[0]) and _args[1] gte 1 and !($worn.neck.name is "familiar collar" and $worn.neck.cursed is 1)>>
		<<if _args[0] isnot "wolf" and $worn.neck.name isnot "spiked collar" and $worn.neck.name isnot "spiked collar with leash">>
			<<set $wolfbuild = Math.clamp($wolfbuild - _args[1], 0, 100)>>
		<</if>>
		<<if _args[0] isnot "cat" and $worn.neck.name isnot "cat bell collar" and $worn.head.name isnot "fish hairpin">>
			<<set $catbuild  = Math.clamp($catbuild  - _args[1], 0, 100)>>
		<</if>>
		<<if _args[0] isnot "cow" and $worn.neck.name isnot "cow bell">>
			<<set $cowbuild  = Math.clamp($cowbuild  - _args[1], 0, 100)>>
		<</if>>
		<<if _args[0] isnot "bird" and $worn.head.name isnot "feathered hair clip" and $worn.neck.name isnot "feather necklace">>
			<<set $birdbuild = Math.clamp($birdbuild - _args[1], 0, 100)>>
		<</if>>
		<<if _args[0] isnot "fox" and $worn.head.name isnot "spirit mask" and $worn.neck.name isnot "jasper pendant">>
			<<set $foxbuild = Math.clamp($foxbuild - _args[1], 0, 100)>>
		<</if>>
		<<if _args[0] isnot "sheep" and $worn.head.name isnot "cloud hair clip">>
			<<set $sheepbuild = Math.clamp($sheepbuild - _args[1], 0, 100)>>
		<</if>>
		<<if _args[0] isnot "bee" and $worn.head.name isnot "honeycomb hair clip">>
			<<set $beebuild = Math.clamp($beebuild - _args[1], 0, 100)>>
		<</if>>
		<<if _args[0] isnot "deer" and $worn.head.name isnot "spotted hair clip">>
			<<set $deerbuild = Math.clamp($deerbuild - _args[1], 0, 100)>>
		<</if>>
		<<if _args[0] isnot "bear" and $worn.head.name isnot "honeycomb hair clip" and $worn.head.name isnot "honey hair clip" and $worn.handheld.name isnot "honey pouch" and $worn.handheld.name isnot "bear bag">>
			<<set $bearbuild = Math.clamp($bearbuild - _args[1], 0, 100)>>
		<</if>>
		<<if _args[0] isnot "bunny" and $worn.head.name isnot "carrot pin">>
			<<set $bunnybuild = Math.clamp($bunnybuild - _args[1], 0, 100)>>
		<</if>>
		<<if _args[0] isnot "waterdragon" and $worn.earrings.variable isnot "lilacheadpiece">>
			<<set $waterdragonbuild = Math.clamp($waterdragonbuild - _args[1], 0, 100)>>
		<</if>>
		<<if _args[0] isnot "dragon" and $worn.hands.name isnot "dragonstone ring">>
			<<set $dragonbuild = Math.clamp($dragonbuild - _args[1], 0, 100)>>
		<</if>>
		<<if _args[0] isnot "lizard" and $worn.hands.name isnot "dragonstone ring">>
			<<set $lizardbuild = Math.clamp($lizardbuild - _args[1], 0, 100)>>
		<</if>>
		<<if _args[0] isnot "dolphin" and $worn.head.name isnot "fish hairpin">>
			<<set $dolphinbuild = Math.clamp($dolphinbuild - _args[1], 0, 100)>>
		<</if>>
		<<if _args[0] isnot "raccoon" and $worn.hands.name isnot "scuffed ring" and $worn.head.name isnot "raccoon cap">>
			<<set $raccoonbuild = Math.clamp($raccoonbuild - _args[1], 0, 100)>>
		<</if>>
		<<if _args[0] isnot "fish" and $worn.head.name isnot "fish hairpin">>
			<<set $fishbuild = Math.clamp($fishbuild - _args[1], 0, 100)>>
		<</if>>
		<<if _args[0] isnot "horse" and $worn.neck.name isnot "horseshoe pendant">>
			<<set $horsebuild = Math.clamp($horsebuild - _args[1], 0, 100)>>
		<</if>>
		<<if _args[0] isnot "spider" and $worn.neck.name isnot "cloth choker">>
			<<set $spiderbuild = Math.clamp($spiderbuild - _args[1], 0, 100)>>
		<</if>>
		<<if _args[0] isnot "frog" and $worn.head.name isnot "frog hat">>
			<<set $frogbuild = Math.clamp($frogbuild - _args[1], 0, 100)>>
		<</if>>
		<<if _args[0] isnot "pig" and $worn.head.name isnot "truffle hair clip">>
			<<set $pigbuild = Math.clamp($pigbuild - _args[1], 0, 100)>>
		<</if>>
		<<if _args[0] isnot "dog" and $worn.neck.name isnot "spiked collar" and $worn.neck.name isnot "spiked collar with leash">>
			<<set $dogbuild = Math.clamp($dogbuild - _args[1], 0, 100)>>
		<</if>>
	<</if>>
<</widget>>

<<widget "transformationStateUpdate">>
	<<run PlusTransform.migrate(V)>>
	<<set _seraphimActive to ($transformationParts isnot undefined and $transformationParts.seraphim isnot undefined and $transformationParts.seraphim.wings isnot undefined and $transformationParts.seraphim.wings isnot "hidden" and $transformationParts.seraphim.wings isnot "disabled")>>
	<<set _kitsuneActive to ($transformationParts isnot undefined and $transformationParts.kitsune isnot undefined and $transformationParts.kitsune.tail isnot undefined and $transformationParts.kitsune.tail isnot "hidden" and $transformationParts.kitsune.tail isnot "disabled")>>
	<<set _okamiActive to ($transformationParts isnot undefined and $transformationParts.okami isnot undefined and $transformationParts.okami.misc isnot undefined and $transformationParts.okami.misc isnot "hidden" and $transformationParts.okami.misc isnot "disabled")>>
	<<if !($worn.neck.name is "familiar collar" and $worn.neck.cursed is 1)>>
		<<if $wolfbuild gte 1 and $worn.neck.name isnot "spiked collar" and $worn.neck.name isnot "spiked collar with leash" and playerNormalPregnancyType() isnot "wolf" and !_okamiActive>>
			<<transform wolf -1>>
		<</if>>
		<<if $catbuild gte 1 and $worn.neck.name isnot "cat bell collar" and $worn.head.name isnot "fish hairpin" and playerNormalPregnancyType() isnot "cat">>
			<<transform cat -1>>
		<</if>>
		<<if $cowbuild gte 1 and $worn.neck.name isnot "cow bell" and playerNormalPregnancyType() isnot "cow">>
			<<transform cow -1>>
		<</if>>
		<<if $birdbuild gte 1 and $worn.head.name isnot "feathered hair clip" and $worn.neck.name isnot "feather necklace" and playerNormalPregnancyType() isnot "hawk" and !_seraphimActive>>
			<<transform bird -1>>
		<</if>>
		<<if $foxbuild gte 1 and $worn.head.name isnot "spirit mask" and $worn.neck.name isnot "jasper pendant" and playerNormalPregnancyType() isnot "fox" and !_kitsuneActive>>
			<<transform fox -1>>
		<</if>>
		<<if $sheepbuild gte 1 and $worn.head.name isnot "cloud hair clip">>
			<<transform sheep -1>>
		<</if>>
		<<if $beebuild gte 1 and $worn.head.name isnot "honeycomb hair clip">>
			<<transform bee -1>>
		<</if>>
		<<if $deerbuild gte 1 and $worn.head.name isnot "spotted hair clip">>
			<<transform deer -1>>
		<</if>>
		<<if $bearbuild gte 1 and $worn.head.name isnot "honeycomb hair clip" and $worn.head.name isnot "honey hair clip" and $worn.handheld.name isnot "honey pouch" and $worn.handheld.name isnot "bear bag" and playerNormalPregnancyType() isnot "bear">>
			<<transform bear -1>>
		<</if>>
		<<if $bunnybuild gte 1 and $worn.head.name isnot "carrot pin" and playerNormalPregnancyType() isnot "bunny">>
			<<transform bunny -1>>
		<</if>>
		<<if $waterdragonbuild gte 1 and $worn.earrings.variable isnot "lilacheadpiece" and playerNormalPregnancyType() isnot "waterdragon">>
			<<transform waterdragon -1>>
		<</if>>
		<<if $dragonbuild gte 1 and $worn.hands.name isnot "dragonstone ring">>
			<<transform dragon -1>>
		<</if>>
		<<if $lizardbuild gte 1 and $worn.hands.name isnot "dragonstone ring">>
			<<transform lizard -1>>
		<</if>>
		<<if $dolphinbuild gte 1 and $worn.head.name isnot "fish hairpin">>
			<<transform dolphin -1>>
		<</if>>
		<<if $raccoonbuild gte 1 and $worn.hands.name isnot "scuffed ring" and $worn.head.name isnot "raccoon cap">>
			<<transform raccoon -1>>
		<</if>>
		<<if $fishbuild gte 1 and $worn.head.name isnot "fish hairpin">>
			<<transform fish -1>>
		<</if>>
		<<if $horsebuild gte 1 and $worn.neck.name isnot "horseshoe pendant">>
			<<transform horse -1>>
		<</if>>
		<<if $spiderbuild gte 1 and $worn.neck.name isnot "cloth choker">>
			<<transform spider -1>>
		<</if>>
		<<if $frogbuild gte 1 and $worn.head.name isnot "frog hat">>
			<<transform frog -1>>
		<</if>>
		<<if $pigbuild gte 1 and $worn.head.name isnot "truffle hair clip">>
			<<transform pig -1>>
		<</if>>
		<<if $dogbuild gte 1 and $worn.neck.name isnot "spiked collar" and $worn.neck.name isnot "spiked collar with leash">>
			<<transform dog -1>>
		<</if>>
		<<if $wolfgirl gte 6>>
			<<def 5>>
		<</if>>
	<</if>>

	<<if _seraphimActive>>
		<<set $harpy to Math.max($harpy, 6)>>
		<<set $birdbuild to Math.max($birdbuild, 100)>>
		<<set $angel to Math.max($angel, 6)>>
		<<set $angelbuild to Math.max($angelbuild, 50)>>
		<<set $specialTransform to 1>>
	<</if>>
	<<if _kitsuneActive>>
		<<set $fox to Math.max($fox, 6)>>
		<<set $foxbuild to Math.max($foxbuild, 100)>>
		<<set $angel to Math.max($angel, 6)>>
		<<set $angelbuild to Math.max($angelbuild, 50)>>
		<<set $specialTransform to 1>>
	<</if>>
	<<if _okamiActive>>
		<<set $wolfgirl to Math.max($wolfgirl, 6)>>
		<<set $wolfbuild to Math.max($wolfbuild, 100)>>
		<<set $angel to Math.max($angel, 6)>>
		<<set $angelbuild to Math.max($angelbuild, 50)>>
		<<set $specialTransform to 1>>
	<</if>>

	<<transformationAlteration>>

	<<if PlusTransform.hasPhysicalTransform(V)>>
		<<set $physicalTransform to 1>>
	<<else>>
		<<set $physicalTransform to 0>>
	<</if>>

	<<if ($physicalTransform is 1 or $specialTransform is 1) and !($hypnosis_traits.peace and $settings.hypnosisEnabled)>>
		<<if (($harpy gte 6 and $transformationParts.traits.activeTF is "disabled") or $transformationParts.traits.activeTF is "bird") and ((($angel gte 6 and $transformationParts.traits.activeTF is "disabled") or $transformationParts.traits.activeTF is "angel") or (($fallenangel gte 2 and $transformationParts.traits.activeTF is "disabled") or $transformationParts.traits.activeTF is "fallenAngel") or (($demon gte 6 and $transformationParts.traits.activeTF is "disabled") or $transformationParts.traits.activeTF is "demon"))>>
			<<if $transformationParts.bird.wings is "hidden" and ($transformationParts.demon.wings is "hidden" or $transformationParts.angel.wings is "hidden" or $transformationParts.fallenAngel.wings is "hidden")>>
			<<else>>
				<<set _excludeWings to true>>
			<</if>>
		<</if>>
		<<set _keys to Object.keys($transformationParts)>>
		<<for _i to 0; _i lt _keys.length; _i++>>
			<<set _key to _keys[_i]>>
			<<for _label, _value range $transformationParts[_key]>>
				<<if _value is "hidden" and _key isnot "traits" and !["pubes", "pits"].includes(_label) and !(_label is "wings" and _excludeWings is true)>>
					<<if $panicattacks gte 2>>
						<<set $transformationParts[clone(_key)][clone(_label)] to "default">>
						<<set _hidingFailed to true>>
						<<set $effectsmessage to 1>>
						<<set $hiddenTransformMessage to 1>>
					<<else>>
						<<trauma 15>>
						<<set $effectsmessage to 1>>
						<<set $hiddenTransformMessage to 2>>
					<</if>>
				<</if>>
			<</for>>
		<</for>>
	<</if>>

	<<set _tfs to PlusTransform.historyVars>>
	<<for _i to 0; _i lt _tfs.length; _i++>>
		<<set _tf to _tfs[_i]>>
		<<if V[_tf] gte (_tf is "fallenangel" ? 2 : (_tf is "waterdragon" ? 7 : 6))>>
			<<set $transformationHistory.pushUnique(_tf)>>
		<</if>>
	<</for>>
<</widget>>

<<widget "plusResolveTransformPreferred">>
	<<run PlusTransform.migrate(V)>>
	<<run PlusTransform.fallbackPreferred(V)>>
	<<set _displayedTransform to PlusTransform.resolve(V)>>
	<<set _transformChoiceOptions to PlusTransform.listboxMap(V)>>
<</widget>>

<<widget "plusHideInactiveAnimalParts">>
	<<set _keep to PlusTransform.keepPartGroups(_args[0])>>
	<<if $transformationParts and _args[0]>>
		<<set _skip to ["traits", "angel", "fallenAngel", "demon"]>>
		<<for _group, _parts range $transformationParts>>
			<<if !_skip.includes(_group) and !_keep.includes(_group) and typeof _parts is "object">>
				<<for _part, _value range _parts>>
					<<if _value isnot "disabled">>
						<<set $transformationParts[_group][_part] to "disabled">>
					<</if>>
				<</for>>
			<</if>>
		<</for>>
	<</if>>
<</widget>>

<<widget "plusCatchupTransform">>
	<<set _key to _args[0]>>
	<<if _key and PlusTransform.catalog[_key]>>
		<<set _catchKey to (PlusTransform.catalog[_key].kind is "hybrid" ? PlusTransform.catalog[_key].component : _key)>>
		<<set _stageVar to PlusTransform.catalog[_catchKey].stageVar>>
		<<for _i to 0; _i lt 10; _i++>>
			<<set _before to State.variables[_stageVar]>>
			<<switch _catchKey>>
				<<case "wolf">><<wolfTransform $wolfgirl>>
				<<case "cat">><<catTransform $cat>>
				<<case "cow">><<cowTransform $cow>>
				<<case "bird">><<harpyTransform $harpy>>
				<<case "fox">><<foxTransform $fox>>
				<<case "bunny">><<bunnyTransform $bunny>>
				<<case "bee">><<beeTransform $bee>>
				<<case "sheep">><<sheepTransform $sheep>>
				<<case "deer">><<deerTransform $deer>>
				<<case "bear">><<bearTransform $bear>>
				<<case "waterdragon">><<waterdragonTransform $waterdragon>>
				<<case "dragon">><<dragonTransform $dragon>>
				<<case "lizard">><<lizardTransform $lizard>>
				<<case "dolphin">><<dolphinTransform $dolphin>>
				<<case "dog">><<dogTransform $dog>>
				<<case "fish">><<fishTransform $fish>>
				<<case "raccoon">><<raccoonTransform $raccoon>>
				<<case "horse">><<horseTransform $horse>>
				<<case "spider">><<spiderTransform $spider>>
				<<case "frog">><<frogTransform $frog>>
				<<case "pig">><<pigTransform $pig>>
			<</switch>>
			<<if State.variables[_stageVar] lte _before>><<break>><</if>>
		<</for>>
	<</if>>
<</widget>>

<<widget "plusApplyTransformChoice">>
	<<plusResolveTransformPreferred>>
	<<transformationAlteration>>
<</widget>>

<<widget "plusTransformChoiceBox">>
	<<plusResolveTransformPreferred>>
	<div id="plus-transform-choice" class="transform-choice">
		Displayed transformation:
		<<listbox "$transformPreferred" autoselect>>
			<<optionsfrom _transformChoiceOptions>>
		<</listbox>>
		<<button "Apply">>
			<<plusApplyTransformChoice>>
			<<updatesidebarimg>>
			<<goto `passage()`>>
		<</button>>
		<br>
		<<if $transformPreferred is "automatic">>
			Uses New World's priority order<<if _displayedTransform>> (currently <<print PlusTransform.label(_displayedTransform)>>)<</if>>.
		<<else>>
			Showing <<print PlusTransform.label($transformPreferred)>>. If you no longer qualify for this form, the game will switch back to Automatic.
		<</if>>
	</div>
<</widget>>

<<widget "transformationAlteration">>
	<<if $settings.transformDivineEnabled>>
		<<if ($demonbuild gte 5 and $specialTransform isnot 1) or ($demon gte 1 and $specialTransform is 1)>>
			<<demonTransform $demon>>
		<<elseif ($angelbuild gte 5 and $specialTransform isnot 1) or ($angel gte 1 and $specialTransform is 1)>>
			<<angelTransform $angel>>
		<<elseif $fallenangel gte 2>>
			<<fallenButNotOut $fallenangel>>
		<</if>>
	<</if>>

	<<if $settings.transformAnimalEnabled>>
		<<plusResolveTransformPreferred>>
		<<if _displayedTransform>>
			<<plusHideInactiveAnimalParts _displayedTransform>>
			<<plusCatchupTransform _displayedTransform>>
			<<run PlusTransform.restoreDisplayedParts(V, _displayedTransform)>>
		<</if>>
	<</if>>
<</widget>>

<<widget "hirsuteHideCheck">>
	<<if !$settings.pubicHairEnabled and !["hidden", "disabled"].includes($transformationParts.wolf.pubes)>>
		<<set $transformationParts.wolf.pubes to "hidden">>
	<</if>>
	<<if !$settings.pubicHairEnabled and !["hidden", "disabled"].includes($transformationParts.wolf.pits)>>
		<<set $transformationParts.wolf.pits to "hidden">>
	<</if>>
	<<if !$settings.pubicHairEnabled and !["hidden", "disabled"].includes($transformationParts.bird.pubes)>>
		<<set $transformationParts.bird.pubes to "hidden">>
	<</if>>
<</widget>>

<<widget "hideTransformations">>
	<<set $saveTransformations to clone($transformationParts)>>
	<<for _transformation, _parts range $transformationParts>>
		<<for _part, _value range _parts>>
			<<if _value isnot "disabled" and _value isnot "hidden">>
				<<set V.transformationParts[_transformation][_part] to "hidden">>
			<</if>>
		<</for>>
	<</for>>
<</widget>>

<<widget "showTransformations">>
	<<if $saveTransformations isnot undefined>>
		<<set $transformationParts to clone($saveTransformations)>>
		<<unset $saveTransformations>>
	<</if>>
<</widget>>

<<widget "fallenTransform">>
	<<if $angel gte 6>>
		<span class="red">Your halo shatters and your wings blacken. An overwhelming sense of loss overcomes you.</span>
		<<set $fallenangel to 2>>
		<<clearhalo>>
		<<clearwings>>
		<<set $transformationParts.fallenAngel.halo to "default">>
		<<set $transformationParts.fallenAngel.wings to "default">>
		<<set $fallenangeltf to 1>>
		<<set $permanentTransform to 1>>
		<<earnFeat "Fallen Angel">>
		<<set $speechFallenTransform to 1>>
	<<elseif $angel gte 4>>
		<span class="red">Your halo shatters and fades.</span>
	<</if>>
	<<if $angel gt 0>>
		<<angelTransform 99>>
	<</if>>
	<<if $fallenangel is 2>>
		<<set $specialTransform to 1>>
	<</if>>
<</widget>>

<<widget "fallenstart">>
	<<clearDivineTransformations>>
	<<set $angel to 6>>
	<<fallenTransform>>
<</widget>>

<<widget "fallenButNotOut">>
	<<if _args[0] gte 0>>
		<<switch _args[0]>>
			<<case 2>>
				<<if $fallenbuild gte 20>>
					<<set $fallenangel to 3>>
					<<run $timeMessages.pushUnique("fallenAngelFeathers")>>
				<</if>>
			<<case 3>>
				<<if $fallenbuild gte 30>>
					<<set $fallenangel to 4>>
					<<run $timeMessages.pushUnique("fallenAngelWings")>>
					<<clearwings>>
					<<set $transformationParts.fallenAngel.wings to ($transformationParts.fallenAngel.wings is "classic" ? "classic-fallenplus" : "fallenplus")>>
				<</if>>
			<<case 99>>
				<<set $specialTransform to 0>>
				<<set $fallenangel to 0>>
				<<set $transformationParts.fallenAngel.halo to "disabled">>
				<<set $transformationParts.fallenAngel.wings to "disabled">>
		<</switch>>
	<</if>>
<</widget>>

<<widget "fallenDescend">>
	<<set $demonbuild to 30>>
	<<set $demon to 6>>
	<<set $fallenangel to 1>>
	<<set $specialTransform to 1>>
	<span class="gold">Your blackened wings turn blacker still. Your shattered halo fades. Horns sprout from your scalp and a tail sprouts from your lower back. Your sense of loss is replaced with a desire for revenge.</span>
	<<clearhalo>>
	<<clearwings>>
	<<cleartail>>
	<<clearwings>>
	<<set $transformationParts.fallenAngel.halo to "disabled">>
	<<set $transformationParts.fallenAngel.wings to "disabled">>

	<<set $transformationParts.demon.horns to "default">>
	<<set $transformationParts.demon.tail to "default">>
	<<set $hastail to "true">>
	<<set $thintail to "true">>
	<<set $transformationParts.demon.wings to "default">>
	<<set $demontf to 1>>
	<<earnFeat "Demon">>
	<<garousal>><<arousal 600>>
<</widget>>

<<widget "angelTransform">>
	<<if _args[0] gte 0>>
		<<switch _args[0]>>
			<<case 0>>
				<<if $angelbuild gte 25>>
					<<set $angel to 1>>
					<<set $specialTransform to 1>>
					<<run $timeMessages.pushUnique("angelUp1")>>
					<br><br>
				<</if>>
			<<case 1>>
				<<if $angelbuild gte 30>>
					<<set $angel to 2>>
					<<run $timeMessages.pushUnique("angelUp2")>>
					<br><br>
				<<elseif $angelbuild lt 25>>
					<<set $angel to 0>>
					<<set $specialTransform to 0>>
					<<run $timeMessages.pushUnique("angelDown0")>>
					<br><br>
				<</if>>
			<<case 2>>
				<<if $angelbuild gte 35>>
					<<set $angel to 3>>
					<<run $timeMessages.pushUnique("angelUp3")>>
					<br><br>
				<<elseif $angelbuild lt 30>>
					<<set $angel to 1>>
					<<run $timeMessages.pushUnique("angelDown1")>>
					<br><br>
				<</if>>
			<<case 3>>
				<<if $angelbuild gte 40>>
					<<set $angel to 4>>
					<<run $timeMessages.pushUnique("angelUp4")>>
					<<clearhalo>>
					<<set $transformationParts.angel.halo to "default">>
				<<elseif $angelbuild lt 35>>
					<<set $angel to 2>>
					<<run $timeMessages.pushUnique("angelDown2")>>
					<br><br>
				<</if>>
			<<case 4>>
				<<if $angelbuild gte 45 and $settings.transformDivineEnabled>>
					<<set $angel to 5>>
					<<run $timeMessages.pushUnique("angelUp5")>>
					<br><br>
				<<elseif $angelbuild lt 40>>
					<<set $angel to 3>>
					<<run $timeMessages.pushUnique("angelDown3")>>
					<<set $transformationParts.angel.halo to "disabled">>
				<</if>>
			<<case 5>>
				<<if $angelbuild gte 50 and $settings.transformDivineEnabled>>
					<<set $angel to 6>>
					<<run $timeMessages.pushUnique("angelUp6")>>
					<<clearwings>>
					<<set $transformationParts.angel.wings to "default">>
					<<if $transformationParts.bird.wings is "default">>
						<<set $transformationParts.angel.wings to "hidden">>
					<</if>>
					<<set $permanentTransform to 1>>
					<<set $angeltf to 1>>
					<<earnFeat "Angel">>
					<br><br>
				<<elseif $angelbuild lt 45>>
					<<set $angel to 4>>
					<<run $timeMessages.pushUnique("angelDown4")>>
					<br><br>
				<</if>>
			<<case 6>>
				<<if $angelbuild lt 50>>
					<<run $timeMessages.pushUnique("angelDown5")>>
					<<set $angel to 5>>
					<<run $timeMessages.pushUnique("angelDown5")>>
					<<set $transformationParts.angel.wings to "disabled">>
				<</if>>
			<<case 99>>
				<<set $specialTransform to 0>>
				<<set $angel to 0>>
				<<set $angelbuild to 0>>
				<<set $transformationParts.angel.halo to "disabled">>
				<<set $transformationParts.angel.wings to "disabled">>
		<</switch>>
	<<else>>
		<<clearDivineTransformations>>
		<<set $specialTransform to 1>>
		<<set $angel to 6>>
		<<set $angelbuild to 50>>
		<<set $permanentTransform to 1>>
		<<set $angeltf to 1>>
		<<clearhalo>>
		<<clearwings>>
		<<set $transformationParts.angel.halo to "default">>
		<<set $transformationParts.angel.wings to "default">>
	<</if>>
<</widget>>

<<widget "demonTransform">>
	<<if _args[0] gte 0>>
		<<switch _args[0]>>
			<<case 0>>
				<<if $demonbuild gte 5 and $settings.transformDivineEnabled and $specialTransform isnot 1>>
					<<set $demon to 1>>
					<<set $specialTransform to 1>>
					<<run $timeMessages.pushUnique("demonUp1")>>
					<<arousal 600>>
				<</if>>
			<<case 1>>
				<<if $demonbuild gte 10 and $settings.transformDivineEnabled>>
					<<set $demon to 2>>
					<<run $timeMessages.pushUnique("demonUp2")>>
					<<arousal 600>>
					<<set $transformationParts.demon.horns to "default">>
				<<elseif $demonbuild lt 5>>
					<<set $demon to 0>>
					<<set $specialTransform to 0>>
					<<run $timeMessages.pushUnique("demonDown0")>>
				<</if>>
			<<case 2>>
				<<if $demonbuild gte 15 and $settings.transformDivineEnabled>>
					<<set $demon to 3>>
					<<run $timeMessages.pushUnique("demonUp3")>>
					<<arousal 600>>
				<<elseif $demonbuild lt 10>>
					<<set $demon to 1>>
					<<run $timeMessages.pushUnique("demonDown1")>>
					<<set $transformationParts.demon.horns to "disabled">>
				<</if>>
			<<case 3>>
				<<if $demonbuild gte 20 and $settings.transformDivineEnabled>>
					<<set $demon to 4>>
					<<run $timeMessages.pushUnique("demonUp4")>>
					<<set $transformationParts.demon.tail to "default">>
					<<arousal 600>>
				<<elseif $demonbuild lt 15>>
					<<set $demon to 2>>
					<<run $timeMessages.pushUnique("demonDown2")>>
				<</if>>
			<<case 4>>
				<<if $demonbuild gte 25 and $settings.transformDivineEnabled>>
					<<set $demon to 5>>
					<<run $timeMessages.pushUnique("demonUp5")>>
					<<arousal 600>>
				<<elseif $demonbuild lt 20>>
					<<set $demon to 3>>
					<<run $timeMessages.pushUnique("demonDown3")>>
					<<set $transformationParts.demon.tail to "disabled">>
					<<set $hastail to "false">>
					<<set $thintail to "false">>
					<<set $transformationParts.traits.flaunting to "disabled">>
				<</if>>
			<<case 5>>
				<<if $demonbuild gte 30 and $settings.transformDivineEnabled>>
					<<set $demon to 6>><<set $demonFeat to true>>
					<<run $timeMessages.pushUnique("demonUp6")>>
					<<arousal 600>>
					<<set $transformationParts.demon.wings to "default">>
					<<set $permanentTransform to 1>>
					<<set $demontf to 1>>
					<<earnFeat "Demon">>
					<br><br>
				<<elseif $demonbuild lt 25>>
					<<set $demon to 4>>
					<<run $timeMessages.pushUnique("demonDown4")>>
					<br><br>
				<</if>>
			<<case 6>>
				<<if $demonbuild lt 30>>
					<<set $demon to 5>>
					<<run $timeMessages.pushUnique("demonDown5")>>
					<<set $transformationParts.demon.wings to "disabled">>
				<<else>>
					<<set $demonFeat to true>>
				<</if>>
			<<case 99>>
				<<set $specialTransform to 0>>
				<<set $demon to 0>>
				<<set $demonbuild to 0>>
				<<set $transformationParts.demon.horns to "disabled">>
				<<set $transformationParts.demon.tail to "disabled">>
				<<set $hastail to "false">>
				<<set $thintail to "false">>
				<<set $transformationParts.demon.wings to "disabled">>
				<<set $transformationParts.traits.flaunting to "disabled">>
		<</switch>>
	<<else>>
		<<clearDivineTransformations>>
		<<set $specialTransform to 1>>
		<<set $demon to 6>>
		<<set $demonbuild to 30>>
		<<set $permanentTransform to 1>>
		<<set $demontf to 1>>
		<<clearhorns>>
		<<cleartail>>
		<<clearwings>>
		<<set $transformationParts.demon.horns to "default">>
		<<set $transformationParts.demon.tail to "default">>
		<<set $hastail to "true">>
		<<set $thintail to "true">>
		<<set $transformationParts.demon.wings to "default">>
	<</if>>
<</widget>>

<<widget "wolfTransform">>
	<<if _args[0] gte 0>>
		<<switch _args[0]>>
			<<case 0>>
				<<if $wolfbuild gte 5 and $physicalTransform isnot 1>>
					<<set $wolfgirl to 1>>
					<<set $physicalTransform to 1>>
					<<run $timeMessages.pushUnique("wolfUp1")>>
				<</if>>
			<<case 1>>
				<<if $wolfbuild gte 10>>
					<<set $wolfgirl to 2>>
					<<run $timeMessages.pushUnique("wolfUp2")>>
					<<set $transformationParts.traits.fangs to "default">>
				<<elseif $wolfbuild lt 5>>
					<<set $wolfgirl to 0>>
					<<run $timeMessages.pushUnique("wolfDown0")>>
					<<set $physicalTransform to 0>>
				<</if>>
			<<case 2>>
				<<if $wolfbuild gte 15>>
					<<set $wolfgirl to 3>>
					<<run $timeMessages.pushUnique("wolfUp3")>>
				<<elseif $wolfbuild lt 10>>
					<<set $wolfgirl to 1>>
					<<run $timeMessages.pushUnique("wolfDown1")>>
					<<set $transformationParts.traits.fangs to "disabled">>
				<</if>>
			<<case 3>>
				<<if $wolfbuild gte 20>>
					<<set $wolfgirl to 4>>
					<<run $timeMessages.pushUnique("wolfUp4")>>
					<<set $transformationParts.wolf.ears to "default">>
					<<set $transformationParts.wolf.pubes to ($settings.pubicHairEnabled? "default" : "hidden")>>
					<<set $transformationParts.wolf.pits to ($settings.pubicHairEnabled? "default" : "hidden")>>
				<<elseif $wolfbuild lt 15>>
					<<set $wolfgirl to 2>>
					<<run $timeMessages.pushUnique("wolfDown2")>>
				<</if>>
			<<case 4>>
				<<if $wolfbuild gte 25>>
					<<set $wolfgirl to 5>>
					<<run $timeMessages.pushUnique("wolfUp5")>>
					<<set $transformationParts.wolf.cheeks to "feral">>
				<<elseif $wolfbuild lt 20>>
					<<set $wolfgirl to 3>>
					<<run $timeMessages.pushUnique("wolfDown3")>>
					<<set $transformationParts.wolf.ears to "disabled">>
					<<set $transformationParts.wolf.pubes to "disabled">>
					<<set $transformationParts.wolf.pits to "disabled">>
				<</if>>
			<<case 5>>
				<<if $wolfbuild gte 30>>
					<<set $permanentTransform to 1>>
					<<set $wolftf to 1>>
					<<set $TFWolfBuffs to 1>>
					<<set $wolfgirl to 6>>
					<<run $timeMessages.pushUnique("wolfUp6")>>
					<<set $transformationParts.wolf.tail to "default">>
					<<set $hastail to "true">>
					<<set $thintail to "true">>
					<<earnFeat "Wolf">>
					<br><br>
				<<elseif $wolfbuild lt 25>>
					<<set $wolfgirl to 4>>
					<<run $timeMessages.pushUnique("wolfDown4")>>
					<<set $transformationParts.wolf.cheeks to "disabled">>
				<</if>>
			<<case 6>>
				<<if $wolfbuild lt 30>>
					<<run $timeMessages.pushUnique("wolfDown5")>>
					<<set $wolfgirl to 5>>
					<<set $transformationParts.wolf.tail to "disabled">>
					<<set $hastail to "false">>
					<<set $thintail to "false">>
					<br><br>
				<</if>>
			<<case 99>>
				<<set $physicalTransform to 0>>
				<<set $wolfgirl to 0>>
				<<set $wolfbuild to 0>>
				<<set $TFWolfBuffs to 0>>
				<<set $transformationParts.traits.fangs to "disabled">>
				<<set $transformationParts.wolf.cheeks to "disabled">>
				<<set $transformationParts.wolf.ears to "disabled">>
				<<set $transformationParts.wolf.pubes to "disabled">>
				<<set $transformationParts.wolf.pits to "disabled">>
				<<set $transformationParts.wolf.tail to "disabled">>
				<<set $hastail to "false">>
				<<set $thintail to "false">>
		<</switch>>
	<<else>>
		<<clearAnimalTransformations>>
		<<set $physicalTransform to 1>>
		<<set $permanentTransform to 1>>
		<<set $wolftf to 1>>
					<<set $TFWolfBuffs to 1>>
		<<set $wolfgirl to 6>>
		<<set $wolfbuild to 100>>
		<<clearcheeks>>
		<<clearears>>
		<<cleartail>>
		<<set $transformationParts.traits.fangs to "default">>
		<<set $transformationParts.wolf.cheeks to "feral">>
		<<set $transformationParts.wolf.ears to "default">>
		<<set $transformationParts.wolf.pubes to ($settings.pubicHairEnabled? "default" : "hidden")>>
		<<set $transformationParts.wolf.pits to ($settings.pubicHairEnabled? "default" : "hidden")>>
		<<set $transformationParts.wolf.tail to "default">>
		<<set $hastail to "true">>
		<<set $thintail to "true">>
	<</if>>
<</widget>>

<<widget "catTransform">>
	<<if _args[0] gte 0>>
		<<switch _args[0]>>
			<<case 0>>
				<<if $catbuild gte 25 and $physicalTransform isnot 1>>
					<<set $cat to 1>>
					<<run $timeMessages.pushUnique("catUp1")>>
					<<set $physicalTransform to 1>>
				<</if>>
			<<case 1>>
				<<if $catbuild gte 30 and $settings.transformAnimalEnabled>>
					<<set $cat to 2>>
					<<run $timeMessages.pushUnique("catUp2")>>
					<<set $transformationParts.traits.fangs to "default">>
					<<set $transformationParts.traits.sharpEyes to "default">>
				<<elseif $catbuild lt 25>>
					<<set $cat to 0>><<set $physicalTransform to 0>>
					<<run $timeMessages.pushUnique("catDown0")>>
				<</if>>
			<<case 2>>
				<<if $catbuild gte 35 and $settings.transformAnimalEnabled>>
					<<set $cat to 3>>
					<<run $timeMessages.pushUnique("catUp3")>>
				<<elseif $catbuild lt 30>>
					<<set $cat to 1>>
					<<run $timeMessages.pushUnique("catDown1")>>
					<<set $transformationParts.traits.fangs to "disabled">>
					<<set $transformationParts.traits.sharpEyes to "disabled">>
				<</if>>
			<<case 3>>
				<<if $catbuild gte 40 and $settings.transformAnimalEnabled>>
					<<set $cat to 4>>
					<<run $timeMessages.pushUnique("catUp4")>>
					<<set $transformationParts.cat.ears to "default">>
				<<elseif $catbuild lt 35>>
					<<set $cat to 2>>
					<<run $timeMessages.pushUnique("catDown2")>>
				<</if>>
			<<case 4>>
				<<if $catbuild gte 45 and $settings.transformAnimalEnabled>>
					<<set $cat to 5>>
					<<run $timeMessages.pushUnique("catUp5")>>
				<<elseif $catbuild lt 40>>
					<<set $cat to 3>>
					<<run $timeMessages.pushUnique("catDown3")>>
					<<set $transformationParts.cat.ears to "disabled">>
				<</if>>
			<<case 5>>
				<<if $catbuild gte 50>>
					<<set $cat to 6>>
					<<run $timeMessages.pushUnique("catUp6")>>
					<<cleartail>>
					<<set $transformationParts.cat.tail to "default">>
					<<set $hastail to "true">>
					<<set $thintail to "true">>
					<<set $cattf to 1>>
					<<set $TFCatBuffs to 1>>
					<<earnFeat "Neko">>
					<br><br>
				<<elseif $catbuild lt 45>>
					<<set $cat to 4>>
					<<run $timeMessages.pushUnique("catDown4")>>
					<br><br>
				<</if>>
			<<case 6>>
				<<if $catbuild gte 55>>
					<<set $cat to 7>>
					<<run $timeMessages.pushUnique("catUp7")>>
					<<run window.determineCatEyeStages()>>
					<<run $timeMessages.pushUnique("catUp7")>>
					<<set $transformationParts.cat.heterochromia to "default">>
					<<catHeterochromiaTF 0>>
				<<elseif $catbuild lt 50>>
					<<set $cat to 5>>
					<<run $timeMessages.pushUnique("catDown5")>>
					<<set $transformationParts.cat.tail to "disabled">>
					<<set $hastail to "false">>
					<<set $thintail to "false">>
					<<set $transformationParts.cat.heterochromia to "disabled">>
				<</if>>
			<<case 7>>
				<<if $catbuild gte 60>>
					<<set $cat to 8>>
					<<run $timeMessages.pushUnique("catUp8")>>
					<<catHeterochromiaTF 1>>
				<<elseif $catbuild lt 55>>
					<<if V.original_colour isnot undefined>>
						<<set $leftEyeColour to $original_colour[0]>>
						<<set $rightEyeColour to $original_colour[1]>>
					<</if>>
					<<set $cat to 6>>
					<<run $timeMessages.pushUnique("catDown6")>>
				<</if>>
			<<case 8>>
				<<if $catbuild gte 65>>
					<<set $cat to 9>>
					<<run $timeMessages.pushUnique("catUp9")>>
					<<catHeterochromiaTF 2>>
				<<elseif $catbuild lt 60>>
					<<catHeterochromiaTF 0>>
					<<set $cat to 7>>
					<<run $timeMessages.pushUnique("catDown7")>>
				<</if>>
			<<case 9>>
				<<if $catbuild gte 70>>
					<<set $cat to 10>>
					<<run $timeMessages.pushUnique("catUp10")>>
					<<catHeterochromiaTF 3>>
				<<elseif $catbuild lt 65>>
					<<catHeterochromiaTF 1>>
					<<set $cat to 8>>
					/* No message for catDown8 */
				<</if>>
			<<case 10>>
				<<if $catbuild lt 70>>
					<<catHeterochromiaTF 2>>
					<<set $cat to 9>>
					<<run $timeMessages.pushUnique("catDown9")>>
				<</if>>
			<<case 99>>
				<<set $physicalTransform to 0>>
				<<set $cat to 0>>
				<<set $catbuild to 0>>
				<<set $TFCatBuffs to 0>>
				<<set $transformationParts.traits.fangs to "disabled">>
				<<set $transformationParts.traits.sharpEyes to "disabled">>
				<<set $transformationParts.cat.ears to "disabled">>
				<<set $transformationParts.cat.tail to "disabled">>
				<<set $hastail to "false">>
				<<set $thintail to "false">>
		<</switch>>
	<<else>>
		<<clearAnimalTransformations>>
		<<set $physicalTransform to 1>>
		<<set $permanentTransform to 1>>
		<<set $cattf to 1>>
					<<set $TFCatBuffs to 1>>
		<<set $cat to 6>>
		<<set $catbuild to 100>>
		<<clearears>>
		<<cleartail>>
		<<set $transformationParts.traits.fangs to "default">>
		<<set $transformationParts.traits.sharpEyes to "default">>
		<<set $transformationParts.cat.ears to "default">>
		<<set $transformationParts.cat.tail to "default">>
		<<set $hastail to "true">>
		<<set $thintail to "true">>
	<</if>>
<</widget>>

<<widget "catHeterochromiaTF">>
	<<if _args[0] gte 0 or _args[0] == "hide">>
		<<if $transformationParts.cat.heterochromia isnot "hidden" and _args[0] isnot "hide">>
			<<set $leftEyeColour to "cat_tf_stage_" + _args[0] + "_left">>
			<<set $rightEyeColour to "cat_tf_stage_" + _args[0] + "_right">>
			<<if _args[0] >= 3>>
				<<set $heterochromia to 1>>
			<<else>>
				<<set $heterochromia to 0>>
			<</if>>
		<<else>>
			<<if V.original_colour isnot undefined>>
				<<set $leftEyeColour to $original_colour[0]>>
				<<set $rightEyeColour to $original_colour[1]>>
			<</if>>
			<<set $heterochromia to 0>>
		<</if>>
	<</if>>
<</widget>>

<<widget "cowTransform">>
	<<if _args[0] gte 0>>
		<<switch _args[0]>>
			<<case 0>>
				<<if $cowbuild gte 5 and $physicalTransform isnot 1>>
					<<set $cow to 1>>
					<<run $timeMessages.pushUnique("cowUp1")>>
					<<set $physicalTransform to 1>>
				<</if>>
			<<case 1>>
				<<if $cowbuild gte 10>>
					<<set $cow to 2>>
					<<run $timeMessages.pushUnique("cowUp2")>>
					<<set $transformationParts.cow.horns to "default">>
				<<elseif $cowbuild lt 5>>
					<<set $cow to 0>><<set $physicalTransform to 0>>
					<<run $timeMessages.pushUnique("cowDown0")>>
				<</if>>
			<<case 2>>
				<<if $cowbuild gte 15>>
					<<set $cow to 3>>
					<<run $timeMessages.pushUnique("cowUp3")>>
				<<elseif $cowbuild lt 10>>
					<<set $cow to 1>>
					<<run $timeMessages.pushUnique("cowDown1")>>
					<<set $transformationParts.cow.horns to "disabled">>
				<</if>>
			<<case 3>>
				<<if $cowbuild gte 20>>
					<<set $cow to 4>>
					<<run $timeMessages.pushUnique("cowUp4")>>
					<<set $transformationParts.cow.ears to "default">>
				<<elseif $cowbuild lt 15>>
					<<set $cow to 2>>
					<<run $timeMessages.pushUnique("cowDown2")>>
				<</if>>
			<<case 4>>
				<<if $cowbuild gte 25>>
					<<set $cow to 5>>
					<<run $timeMessages.pushUnique("cowUp5")>>
				<<elseif $cowbuild lt 20>>
					<<set $cow to 3>>
					<<run $timeMessages.pushUnique("cowDown3")>>
					<<set $transformationParts.cow.ears to "disabled">>
				<</if>>
			<<case 5>>
