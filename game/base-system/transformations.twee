					<<set $beetf to 1>>
					<<set $bee to 6>>
					<<run $timeMessages.pushUnique("beeUp6")>>
					<<earnFeat "Bee">>
					<<clearwings>>
					<<set $transformationParts.bee.wings to "default">>
