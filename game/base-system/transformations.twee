				<<set $sheepbuild to 0>>
				<<set $transformationParts.sheep.tail to "disabled">>
				<<set $hastail to "false">>
				<<set $thintail to "false">>
				<<set $transformationParts.sheep.ears to "disabled">>
				<<set $transformationParts.sheep.horns to "disabled">>
