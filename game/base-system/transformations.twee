<<widget "bearTransform">>
	<<if _args[0] gte 0>>
		<<switch _args[0]>>
			<<case 0>>
				<<if $bearbuild gte 5>>
					<<set $bear to 1>>
					<<run $timeMessages.pushUnique("bearUp1")>>
					<<set $physicalTransform to 1>>
				<</if>>

			<<case 1>>
				<<if $bearbuild gte 10>>
					<<set $bear to 2>>
					<<run $timeMessages.pushUnique("bearUp2")>>
					<<set $transformationParts.traits.fangs to "default">>
				<<elseif $bearbuild lt 5>>
					<<set $bear to 0>><<set $physicalTransform to 0>>
					<<run $timeMessages.pushUnique("bearDown0")>>
				<</if>>

			<<case 2>>
				<<if $bearbuild gte 15>>
					<<set $bear to 3>>
					<<run $timeMessages.pushUnique("bearUp3")>>
				<<elseif $bearbuild lt 10>>
					<<set $bear to 1>>
					<<run $timeMessages.pushUnique("bearDown1")>>
					<<set $transformationParts.traits.fangs to "disabled">>
				<</if>>

			<<case 3>>
				<<if $bearbuild gte 20>>
					<<set $bear to 4>>
					<<run $timeMessages.pushUnique("bearUp4")>>
					<<set $transformationParts.bear.ears to "default">>
					<<set $transformationParts.bear.plumage to "default">>
				<<elseif $bearbuild lt 15>>
					<<set $bear to 2>>
					<<run $timeMessages.pushUnique("bearDown2")>>
				<</if>>

			<<case 4>>
				<<if $bearbuild gte 25>>
					<<set $bear to 5>>
					<<run $timeMessages.pushUnique("bearUp5")>>
				<<elseif $bearbuild lt 20>>
					<<set $bear to 3>>
					<<run $timeMessages.pushUnique("bearDown3")>>
					<<set $transformationParts.bear.plumage to "disabled">>
					<<set $transformationParts.bear.ears to "disabled">>
				<</if>>

			<<case 5>>
				<<if $bearbuild gte 30>>
					<<set $bear to 6>>
					<<run $timeMessages.pushUnique("bearUp6")>>
					<<set $transformationParts.bear.tail to "default">>
					<<if $settings.pubicHairEnabled>>
						<<set $transformationParts.bear.pubes to "default">>
					<</if>>
					<<set $beartf to 1>>
					<<set $TFBearBuffs to 1>>
					<<earnFeat "Bear">>
				<<elseif $bearbuild lt 25>>
					<<set $bear to 4>>
					<<run $timeMessages.pushUnique("bearDown4")>>
				<</if>>

			<<case 6>>
				<<if $bearbuild lt 30>>
					<<set $bear to 5>>
					<<set $TFBearBuffs to 0>>
					<<run $timeMessages.pushUnique("bearDown5")>>
					<<set $transformationParts.bear.tail to "disabled">>
					<<set $transformationParts.bear.pubes to "disabled">>
				<</if>>

			<<case 99>>
				<<if ($bear gte 6 or ($transformationParts.bear.tail isnot "hidden" and $transformationParts.bear.tail isnot "disabled"))>>
					<<set $physicalTransform to 0>>
				<</if>>
				<<set $bear to 0>>
				<<set $TFBearBuffs to 0>>
				<<set $bearbuild to 0>>
				<<set $transformationParts.bear.tail to "disabled">>
				<<set $transformationParts.bear.pubes to "disabled">>
				<<set $transformationParts.bear.plumage to "disabled">>
				<<set $transformationParts.bear.ears to "disabled">>
				<<set $transformationParts.traits.fangs to "disabled">>
		<</switch>>
	<<else>>
		<<clearAnimalTransformations>>
		<<set $physicalTransform to 1>>
		<<set $beartf to 1>>
		<<set $TFBearBuffs to 1>>
		<<set $bear to 6>>
		<<set $bearbuild to 100>>
		<<set $transformationParts.bear.tail to "default">>
		<<if $settings.pubicHairEnabled>>
			<<set $transformationParts.bear.pubes to "default">>
		<</if>>
		<<set $transformationParts.bear.plumage to "default">>
		<<set $transformationParts.bear.ears to "default">>
		<<set $transformationParts.traits.fangs to "default">>
	<</if>>
<</widget>>

<<widget "dragonTransform">>
	<<if _args[0] gte 0>>
		<<switch _args[0]>>
