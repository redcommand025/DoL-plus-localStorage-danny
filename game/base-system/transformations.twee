					<<set $permanentTransform to 1>>
					<<set $cowtf to 1>>
					<<set $TFCowBuffs to 1>>
					<<set $cow to 6>>
					<<run $timeMessages.pushUnique("cowUp6")>>
					<<set $semen_max to 4000>>
					<<set $milk_max to 6000>>
					<<cleartail>>
					<<set $transformationParts.cow.tail to "default">>
					<<set $hastail to "true">>
					<<set $thintail to "true">>
					<<earnFeat "Cattle">>
					<<run $timeMessages.pushUnique("cowUp6")>>
					<br><br>
				<<elseif $cowbuild lt 25>>
					<<set $cow to 4>>
					<<run $timeMessages.pushUnique("cowDown4")>>
					<br><br>
				<</if>>
			<<case 6>>
				<<if $cowbuild lt 30>>
					<<set $semen_max to 3000>>
					<<set $milk_max to 3000>>
					<<run $timeMessages.pushUnique("cowDown5")>>
					<<set $cow to 5>>
					<<run $timeMessages.pushUnique("cowDown5")>>
					<<set $transformationParts.cow.tail to "disabled">>
					<<set $hastail to "false">>
					<<set $thintail to "false">>
					<br><br>
					<<set $permanentTransform to 1>>
				<</if>>
			<<case 99>>
				<<set $physicalTransform to 0>>
				<<set $cow to 0>>
				<<set $cowbuild to 0>>
				<<set $TFCowBuffs to 0>>
				<<set $semen_max to 3000>>
				<<set $milk_max to 3000>>
				<<set $transformationParts.cow.tail to "disabled">>
				<<set $hastail to "false">>
				<<set $thintail to "false">>
				<<set $transformationParts.cow.ears to "disabled">>
				<<set $transformationParts.cow.horns to "disabled">>
		<</switch>>
	<<else>>
		<<clearAnimalTransformations>>
		<<set $physicalTransform to 1>>
		<<set $permanentTransform to 1>>
		<<set $cowtf to 1>>
					<<set $TFCowBuffs to 1>>
		<<set $cow to 6>>
		<<set $cowbuild to 100>>
		<<set $semen_max to 4000>>
		<<set $milk_max to 6000>>
		<<clearhorns>>
		<<clearears>>
		<<cleartail>>
		<<set $transformationParts.cow.horns to "default">>
		<<set $transformationParts.cow.ears to "default">>
		<<set $transformationParts.cow.tail to "default">>
		<<set $hastail to "true">>
		<<set $thintail to "true">>
	<</if>>
	<<semenvolume 0>>
	<<milkvolume 0>>
<</widget>>

<<widget "harpyTransform">>
	<<if _args[0] gte 0>>
		<<switch _args[0]>>
			<<case 0>>
				<<if $birdbuild gte 5 and $physicalTransform isnot 1>>
					<<set $harpy to 1>>
					<<run $timeMessages.pushUnique("harpyUp1")>>
					<<set $physicalTransform to 1>>
				<</if>>
			<<case 1>>
				<<if $birdbuild gte 10>>
					<<set $harpy to 2>>
					<<run $timeMessages.pushUnique("harpyUp2")>>
					<<set $transformationParts.bird.eyes to "default">>
					<<set $transformationParts.bird.malar to "default">>
					<<set $transformationParts.traits.sharpEyes to "default">>
				<<elseif $birdbuild lt 5>>
					<<set $harpy to 0>><<set $physicalTransform to 0>>
					<<run $timeMessages.pushUnique("harpyDown0")>>
				<</if>>
			<<case 2>>
				<<if $birdbuild gte 15>>
					<<set $harpy to 3>>
					<<run $timeMessages.pushUnique("harpyUp3")>>
					<<set $transformationParts.traits.mateForLife to "default">>
				<<elseif $birdbuild lt 10>>
					<<set $harpy to 1>>
					<<run $timeMessages.pushUnique("harpyDown1")>>
					<<set $transformationParts.bird.eyes to "disabled">>
					<<set $transformationParts.bird.malar to "disabled">>
					<<set $transformationParts.traits.sharpEyes to "disabled">>
				<</if>>
			<<case 3>>
				<<if $birdbuild gte 20>>
					<<set $harpy to 4>>
					<<run $timeMessages.pushUnique("harpyUp4")>>
					<<cleartail>>
					<<set $transformationParts.bird.tail to "default">>
					<<set $hastail to "true">>
					<<set $thintail to "true">>
					<<set $transformationParts.bird.plumage to "default">>
				<<elseif $birdbuild lt 15>>
					<<set $harpy to 2>>
					<<run $timeMessages.pushUnique("harpyDown2")>>
					<<set $transformationParts.traits.mateForLife to "disabled">>
				<</if>>
			<<case 4>>
				<<if $birdbuild gte 25>>
					<<set $harpy to 5>>
					<<run $timeMessages.pushUnique("harpyUp5")>>
					<br><br>
				<<elseif $birdbuild lt 20>>
					<<set $harpy to 3>>
					<<run $timeMessages.pushUnique("harpyDown3")>>
					<<set $transformationParts.bird.tail to "disabled">>
					<<set $hastail to "false">>
					<<set $thintail to "false">>
					<<set $transformationParts.bird.plumage to "disabled">>
				<</if>>
			<<case 5>>
				<<if $birdbuild gte 30>>
					<<set $harpy to 6>>
					<<set $harpytf to 1>>
					<<set $TFBirdBuffs to 1>>
					<<run $timeMessages.pushUnique("harpyUp6")>>
					<<set $transformationParts.bird.wings to "default">>
					<<if $settings.pubicHairEnabled>>
						<<set $transformationParts.bird.pubes to "default">>
					<<else>>
						<<set $transformationParts.bird.pubes to "hidden">>
					<</if>>
				<<elseif $birdbuild lt 25>>
					<<set $harpy to 4>>
					<<run $timeMessages.pushUnique("harpyDown4")>>
				<</if>>
			<<case 6>>
				<<if $birdbuild lt 30>>
					<<set $harpy to 5>>
					<<run $timeMessages.pushUnique("harpyDown5")>>
					<<set $transformationParts.bird.wings to "disabled">>
					<<set $transformationParts.bird.pubes to "disabled">>
					<<if $angel gte 6>>
						<<set $transformationParts.angel.wings to "default">>
					<</if>>
					<<if $demon gte 6>>
						<<set $transformationParts.demon.wings to "default">>
					<</if>>
					<<if $fallenangel gte 2>>
						<<set $transformationParts.fallenAngel.wings to "default">>
					<</if>>
					<br><br>
					<<set $permanentTransform to 1>>
				<</if>>
			<<case 99>>
				<<set $physicalTransform to 0>>
				<<set $harpy to 0>>
				<<set $birdbuild to 0>>
				<<set $TFBirdBuffs to 0>>
				<<set $transformationParts.bird.eyes to "disabled">>
				<<set $transformationParts.bird.malar to "disabled">>
				<<set $transformationParts.bird.tail to "disabled">>
				<<set $hastail to "false">>
				<<set $thintail to "false">>
				<<set $transformationParts.bird.plumage to "disabled">>
				<<set $transformationParts.bird.pubes to "disabled">>
				<<set $transformationParts.traits.sharpEyes to "disabled">>
				<<set $transformationParts.traits.mateForLife to "disabled">>
				<<set $transformationParts.bird.wings to "disabled">>
				<<if !["hidden", "disabled"].includes($transformationParts.bird.wings)>>
					<<if $angel gte 6>>
						<<set $transformationParts.angel.wings to "default">>
					<</if>>
					<<if $demon gte 6>>
						<<set $transformationParts.demon.wings to "default">>
					<</if>>
					<<if $fallenangel gte 2>>
						<<set $transformationParts.fallenAngel.wings to "default">>
					<</if>>
				<</if>>
		<</switch>>
	<<else>>
		<<set $physicalTransform to 1>>
		<<set $permanentTransform to 1>>
		<<set $harpytf to 1>>
					<<set $TFBirdBuffs to 1>>
		<<set $harpy to 6>>
		<<set $birdbuild to 100>>
		<<cleareyes>>
		<<cleartail>>
		<<clearwings>>
		<<set $transformationParts.bird.eyes to "default">>
		<<set $transformationParts.bird.malar to "default">>
		<<set $transformationParts.bird.tail to "default">>
		<<set $hastail to "true">>
		<<set $thintail to "true">>
		<<set $transformationParts.bird.plumage to "default">>
		<<set $transformationParts.bird.wings to "default">>
		<<set $transformationParts.traits.sharpEyes to "default">>
		<<set $transformationParts.traits.mateForLife to "default">>
		<<if $settings.pubicHairEnabled>>
			<<set $transformationParts.bird.pubes to "default">>
		<<else>>
			<<set $transformationParts.bird.pubes to "hidden">>
		<</if>>
	<</if>>
<</widget>>

<<widget "foxTransform">>
	<<if _args[0] gte 0>>
		<<switch _args[0]>>
			<<case 0>>
				<<if $foxbuild gte 5 and $physicalTransform isnot 1>>
					<<set $fox to 1>>
					<<run $timeMessages.pushUnique("foxUp1")>>
					<<set $physicalTransform to 1>>
				<</if>>
			<<case 1>>
				<<if $foxbuild gte 10>>
					<<set $fox to 2>>
					<<run $timeMessages.pushUnique("foxUp2")>>
					<<set $transformationParts.traits.fangs to "default">>
					<<set $transformationParts.traits.sharpEyes to "default">>
				<<elseif $foxbuild lt 5>>
					<<set $fox to 0>>
					<<run $timeMessages.pushUnique("foxDown0")>>
					<<set $physicalTransform to 0>>
				<</if>>
			<<case 2>>
				<<if $foxbuild gte 15>>
					<<set $fox to 3>>
					<<run $timeMessages.pushUnique("foxUp3")>>
					<<set $transformationParts.traits.mateForLife to "default">>
				<<elseif $foxbuild lt 10>>
					<<set $fox to 1>>
					<<run $timeMessages.pushUnique("foxDown1")>>
					<<set $transformationParts.traits.fangs to "disabled">>
					<<set $transformationParts.traits.sharpEyes to "disabled">>
				<</if>>
			<<case 3>>
				<<if $foxbuild gte 20>>
					<<set $fox to 4>>
					<<run $timeMessages.pushUnique("foxUp4")>>
					<<set $transformationParts.fox.ears to "default">>
					<<set $transformationParts.traits.chase to "default">>
				<<elseif $foxbuild lt 15>>
					<<set $fox to 2>>
					<<run $timeMessages.pushUnique("foxDown2")>>
					<<set $transformationParts.traits.mateForLife to "disabled">>
				<</if>>
			<<case 4>>
				<<if $foxbuild gte 25>>
					<<set $fox to 5>>
					<<run $timeMessages.pushUnique("foxUp5")>>
					<<set $transformationParts.fox.cheeks to "default">>
				<<elseif $foxbuild lt 20>>
					<<set $fox to 3>>
					<<run $timeMessages.pushUnique("foxDown3")>>
					<<set $transformationParts.fox.ears to "disabled">>
					<<set $transformationParts.traits.chase to "disabled">>
				<</if>>
			<<case 5>>
				<<if $foxbuild gte 30>>
					<<set $permanentTransform to 1>>
					<<set $foxtf to 1>>
					<<set $TFFoxBuffs to 1>>
					<<set $fox to 6>>
					<<run $timeMessages.pushUnique("foxUp6")>>
					<<cleartail>>
					<<set $transformationParts.fox.tail to "default">>
					<<set $hastail to "true">>
					<<set $thintail to "true">>
					<<earnFeat "Fox">>
				<<elseif $foxbuild lt 25>>
					<<set $fox to 4>>
					<<run $timeMessages.pushUnique("foxDown4")>>
					<<set $transformationParts.fox.cheeks to "disabled">>
				<</if>>
			<<case 6>>
				<<if $foxbuild lt 30>>
					<<run $timeMessages.pushUnique("foxDown5")>>
					<<set $fox to 5>>
					<<run $timeMessages.pushUnique("foxDown5")>>
					<<set $transformationParts.fox.tail to "disabled">>
					<<set $hastail to "false">>
					<<set $thintail to "false">>
					<<set $permanentTransform to 1>>
				<</if>>
			<<case 99>>
				<<set $physicalTransform to 0>>
				<<set $fox to 0>>
				<<set $foxbuild to 0>>
				<<set $TFFoxBuffs to 0>>
				<<set $transformationParts.traits.fangs to "disabled">>
				<<set $transformationParts.traits.sharpEyes to "disabled">>
				<<set $transformationParts.traits.mateForLife to "disabled">>
				<<set $transformationParts.traits.chase to "disabled">>
				<<set $transformationParts.fox.cheeks to "disabled">>
				<<set $transformationParts.fox.ears to "disabled">>
				<<set $transformationParts.fox.tail to "disabled">>
				<<set $hastail to "false">>
				<<set $thintail to "false">>
		<</switch>>
	<<else>>
		<<clearAnimalTransformations>>
		<<set $physicalTransform to 1>>
		<<set $permanentTransform to 1>>
		<<set $foxtf to 1>>
					<<set $TFFoxBuffs to 1>>
		<<set $fox to 6>>
		<<set $foxbuild to 100>>
		<<clearcheeks>>
		<<clearears>>
		<<cleartail>>
		<<set $transformationParts.traits.fangs to "default">>
		<<set $transformationParts.traits.sharpEyes to "default">>
		<<set $transformationParts.traits.mateForLife to "default">>
		<<set $transformationParts.traits.chase to "default">>
		<<set $transformationParts.fox.cheeks to "default">>
		<<set $transformationParts.fox.ears to "default">>
		<<set $transformationParts.fox.tail to "default">>
		<<set $hastail to "true">>
		<<set $thintail to "true">>
	<</if>>
<</widget>>

<<widget "bunnyTransform">>
	<<if _args[0] gte 0>>
		<<switch _args[0]>>
			<<case 0>>
				<<if $bunnybuild gte 5>>
					<<set $bunny to 1>>
					<<run $timeMessages.pushUnique("bunnyUp1")>>
					<<set $physicalTransform to 1>>
				<</if>>

			<<case 1>>
				<<if $bunnybuild gte 10>>
					<<set $bunny to 2>>
					<<run $timeMessages.pushUnique("bunnyUp2")>>
					<<set $transformationParts.traits.strongFeet to "default">>
				<<elseif $bunnybuild lt 5>>
					<<set $bunny to 0>>
					<<set $physicalTransform to 0>>
					<<run $timeMessages.pushUnique("bunnyDown0")>>
				<</if>>

			<<case 2>>
				<<if $bunnybuild gte 15>>
					<<set $bunny to 3>>
					<<run $timeMessages.pushUnique("bunnyUp3")>>
				<<elseif $bunnybuild lt 10>>
					<<set $bunny to 1>>
					<<run $timeMessages.pushUnique("bunnyDown1")>>
					<<set $transformationParts.traits.strongFeet to "disabled">>
				<</if>>

			<<case 3>>
				<<if $bunnybuild gte 20>>
					<<set $bunny to 4>>
					<<run $timeMessages.pushUnique("bunnyUp4")>>
					<<set $transformationParts.bunny.ears to "default">>
				<<elseif $bunnybuild lt 15>>
					<<set $bunny to 2>>
					<<run $timeMessages.pushUnique("bunnyDown2")>>
				<</if>>

			<<case 4>>
				<<if $bunnybuild gte 25>>
					<<set $bunny to 5>>
					<<run $timeMessages.pushUnique("bunnyUp5")>>
				<<elseif $bunnybuild lt 20>>
					<<set $bunny to 3>>
					<<run $timeMessages.pushUnique("bunnyDown3")>>
					<<set $transformationParts.bunny.ears to "disabled">>
				<</if>>

			<<case 5>>
				<<if $bunnybuild gte 30>>
					<<set $bunny to 6>>
					<<run $timeMessages.pushUnique("bunnyUp6")>>
					<<set $transformationParts.bunny.tail to "default">>
					<<set $transformationParts.traits.preyAnimal to "default">>
					<<set $bunnytf to 1>>
					<<set $TFBunnyBuffs to 1>>
				<<elseif $bunnybuild lt 25>>
					<<set $bunny to 4>>
					<<run $timeMessages.pushUnique("bunnyDown4")>>
				<</if>>

			<<case 6>>
				<<if $bunnybuild lt 30>>
					<<set $bunny to 5>>
					<<set $TFBunnyBuffs to 0>>
					<<run $timeMessages.pushUnique("bunnyDown5")>>
					<<set $transformationParts.bunny.tail to "disabled">>
					<<set $transformationParts.traits.preyAnimal to "disabled">>
				<</if>>

			<<case 99>>
				<<set $physicalTransform to 0>>
				<<set $bunny to 0>>
				<<set $TFBunnyBuffs to 0>>
				<<set $bunnybuild to 0>>
				<<set $transformationParts.traits.preyAnimal to "disabled">>
				<<set $transformationParts.bunny.ears to "disabled">>
				<<set $transformationParts.bunny.tail to "disabled">>
				<<set $transformationParts.traits.strongFeet to "disabled">>
		<</switch>>
	<<else>>
		<<clearAnimalTransformations>>
		<<set $physicalTransform to 1>>
		<<set $bunny to 6>>
		<<set $bunnybuild to 100>>
		<<set $transformationParts.traits.preyAnimal to "default">>
		<<set $transformationParts.bunny.ears to "default">>
		<<set $transformationParts.bunny.tail to "default">>
		<<set $transformationParts.traits.strongFeet to "default">>
		<<set $bunnytf to 1>>
		<<set $TFBunnyBuffs to 1>>
	<</if>>
<</widget>>

<<widget "waterdragonTransform">>
	<<if _args[0] gte 0>>
		<<switch _args[0]>>
			<<case 0>>
				<<if $waterdragonbuild gte 5>>
					<<set $waterdragon to 1>>
					<<run $timeMessages.pushUnique("waterdragonUp1")>>
					<<set $physicalTransform to 1>>
				<</if>>
			<<case 1>>
				<<if $waterdragonbuild gte 10>>
					<<set $waterdragon to 2>>
					<<run $timeMessages.pushUnique("waterdragonUp2")>>
					<<set $transformationParts.traits.fangs to "default">>
					<<set $transformationParts.traits.sharpEyes to "default">>
					<<set $transformationParts.traits.dragonEyes to "default">>
				<<elseif $waterdragonbuild lt 5>>
					<<set $waterdragon to 0>>
					<<set $physicalTransform to 0>>
					<<run $timeMessages.pushUnique("waterdragonDown0")>>
				<</if>>
			<<case 2>>
				<<if $waterdragonbuild gte 15>>
					<<set $waterdragon to 3>>
					<<set $transformationParts.waterdragon.horns to "default">>
					<<run $timeMessages.pushUnique("waterdragonUp3")>>
				<<elseif $waterdragonbuild lt 10>>
					<<set $waterdragon to 1>>
					<<run $timeMessages.pushUnique("waterdragonDown1")>>
					<<set $transformationParts.traits.fangs to "disabled">>
					<<set $transformationParts.traits.sharpEyes to "disabled">>
					<<set $transformationParts.traits.dragonEyes to "disabled">>
				<</if>>
			<<case 3>>
				<<if $waterdragonbuild gte 20>>
					<<set $waterdragon to 4>>
					<<run $timeMessages.pushUnique("waterdragonUp4")>>
					<<set $transformationParts.waterdragon.ears to "default">>
				<<elseif $waterdragonbuild lt 15>>
					<<set $waterdragon to 2>>
					<<run $timeMessages.pushUnique("waterdragonDown2")>>
					<<set $transformationParts.waterdragon.horns to "disabled">>
				<</if>>
			<<case 4>>
				<<if $waterdragonbuild gte 25>>
					<<set $waterdragon to 5>>
					<<run $timeMessages.pushUnique("waterdragonUp5")>>
				<<elseif $waterdragonbuild lt 20>>
					<<set $waterdragon to 3>>
					<<run $timeMessages.pushUnique("waterdragonDown3")>>
					<<set $transformationParts.waterdragon.ears to "disabled">>
				<</if>>
			<<case 5>>
				<<if $waterdragonbuild gte 30>>
					<<set $waterdragon to 6>>
					<<run $timeMessages.pushUnique("waterdragonUp6")>>
					<<set $transformationParts.waterdragon.tail to "default">>
					<<set $transformationParts.traits.wdgrace to "default">>
					<<set $TFWaterDragonBuffs to 1>>
				<<elseif $waterdragonbuild lt 25>>
					<<set $waterdragon to 4>>
					<<run $timeMessages.pushUnique("waterdragonDown4")>>
				<</if>>
			<<case 6>>
				<<if $waterdragonbuild gte 50>>
					<<set $waterdragon to 7>>
					<<run $timeMessages.pushUnique("waterdragonUp7")>>
					<<set $transformationParts.traits.aquatic to "default">>
					<<set $TFWaterDragonBuffs to 1>>
					<<set $waterdragontf to 1>>
				<<elseif $waterdragonbuild lt 30>>
					<<set $waterdragon to 5>>
					<<set $TFWaterDragonBuffs to 0>>
					<<set $transformationParts.traits.wdgrace to "disabled">>
					<<run $timeMessages.pushUnique("waterdragonDown5")>>
					<<set $transformationParts.waterdragon.tail to "disabled">>
				<</if>>
			<<case 7>>
				<<if $waterdragonbuild lt 50>>
					<<set $waterdragon to 6>>
					<<run $timeMessages.pushUnique("waterdragonDown6")>>
					<<set $transformationParts.traits.aquatic to "disabled">>
					<<set $waterdragontf to 0>>
				<</if>>
			<<case 99>>
				<<if ($waterdragon gte 7 or ($transformationParts.waterdragon.tail isnot "hidden" and $transformationParts.waterdragon.tail isnot "disabled"))>>
					<<set $physicalTransform to 0>>
				<</if>>
				<<set $waterdragon to 0>>
				<<set $TFWaterDragonBuffs to 0>>
				<<set $waterdragonbuild to 0>>
				<<set $waterdragontf to 0>>
				<<set $transformationParts.waterdragon.tail to "disabled">>
				<<set $transformationParts.waterdragon.ears to "disabled">>
				<<set $transformationParts.waterdragon.horns to "disabled">>
				<<set $transformationParts.traits.fangs to "disabled">>
				<<set $transformationParts.traits.aquatic to "disabled">>
				<<set $transformationParts.traits.wdgrace to "disabled">>
				<<set $transformationParts.traits.dragonEyes to "disabled">>
		<</switch>>
	<<else>>
		<<clearAnimalTransformations>>
		<<set $physicalTransform to 1>>
		<<set $waterdragontf to 1>>
		<<set $TFWaterDragonBuffs to 1>>
		<<set $waterdragon to 7>>
		<<set $waterdragonbuild to 100>>
		<<set $transformationParts.waterdragon.horns to "default">>
		<<set $transformationParts.waterdragon.ears to "default">>
		<<set $transformationParts.waterdragon.tail to "default">>
		<<set $transformationParts.traits.sharpEyes to "default">>
		<<set $transformationParts.traits.dragonEyes to "default">>
		<<set $transformationParts.traits.aquatic to "default">>
		<<set $transformationParts.traits.wdgrace to "default">>
	<</if>>
	<<syncWaterDragonSkin>>
<</widget>>

<<widget "syncWaterDragonSkin">>
	<<set _waterDragonSkinActive to ($waterdragon gte 7 or $waterdragontf is 1)>>

	<<if $waterdragonSkinLock is 1>>
		<<if $player.skin.color isnot "waterdragon">>
			<<set $player.skin_temp.color to $player.skin.color>>
			<<set $player.skin.color to "waterdragon">>
		<</if>>
	<<elseif $waterdragonSkinLock is -1>>
		<<if $player.skin.color is "waterdragon">>
			<<set $player.skin.color to $player.skin_temp.color>>
		<</if>>
	<<else>>
		<<if _waterDragonSkinActive>>
			<<if $player.skin.color isnot "waterdragon">>
				<<set $player.skin_temp.color to $player.skin.color>>
				<<set $player.skin.color to "waterdragon">>
			<</if>>
		<<else>>
			<<if $player.skin.color is "waterdragon">>
				<<set $player.skin.color to $player.skin_temp.color>>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

<<widget "raccoonTransform">>
	<<if _args[0] gte 0>>
		<<switch _args[0]>>
			<<case 0>>
				<<if $raccoonbuild gte 5 and $physicalTransform isnot 1>>
					<<set $raccoon to 1>><<set $physicalTransform to 1>>
					<<run $timeMessages.pushUnique("raccoonUp1")>>
					<br><br>
				<</if>>
			<<case 1>>
				<<if $raccoonbuild gte 10>>
					<<set $raccoon to 2>>
					<<clearcheeks>>
					<<set $transformationParts.traits.sharpEyes to "default">>
					<<set $transformationParts.traits.incognito to "default">>
					<<set $transformationParts.raccoon.mask to "default">>
					<<run $timeMessages.pushUnique("raccoonUp2")>>
					<br><br>
				<<elseif $raccoonbuild lt 5>>
					<<set $raccoon to 0>><<set $physicalTransform to 0>>
					<<run $timeMessages.pushUnique("raccoonDown0")>>
					<br><br>
				<</if>>
			<<case 2>>
				<<if $raccoonbuild gte 15>>
					<<set $raccoon to 3>>
					<<run $timeMessages.pushUnique("raccoonUp3")>>
					<br><br>
				<<elseif $raccoonbuild lt 10>>
					<<set $raccoon to 1>>
					<<set $transformationParts.raccoon.mask to "disabled">>
					<<run $timeMessages.pushUnique("raccoonDown1")>>
					<<set $transformationParts.traits.sharpEyes to "disabled">>
					<<set $transformationParts.traits.incognito to "disabled">>
					<br><br>
				<</if>>
			<<case 3>>
				<<if $raccoonbuild gte 20>>
					<<set $raccoon to 4>>
					<<clearears>>
					<<set $transformationParts.raccoon.ears to "default">>
					<<run $timeMessages.pushUnique("raccoonUp4")>>
					<br><br>
				<<elseif $raccoonbuild lt 15>>
					<<set $raccoon to 2>>
					<<run $timeMessages.pushUnique("raccoonDown2")>>
					<br><br>
				<</if>>
			<<case 4>>
				<<if $raccoonbuild gte 25>>
					<<set $raccoon to 5>>
					<<run $timeMessages.pushUnique("raccoonUp5")>>
					<br><br>
				<<elseif $raccoonbuild lte 20>>
					<<set $raccoon to 3>>
					<<set $transformationParts.raccoon.ears to "disabled">>
					<<run $timeMessages.pushUnique("raccoonDown3")>>
					<br><br>
				<</if>>
			<<case 5>>
				<<if $raccoonbuild gte 30>>
					<<set $permanentTransform to 1>>
					<<set $raccoontf to 1>>
					<<set $raccoon to 6>>
					<<cleartail>>
					<<set $transformationParts.raccoon.tail to "default">>
					<<set $hastail to "true">>
					<<set $thintail to "true">>
					<<earnFeat "Raccoon">>
					<<run $timeMessages.pushUnique("raccoonUp6")>>
					<br><br>
				<<elseif $raccoonbuild lt 25>>
					<<set $raccoon to 4>>
					<<run $timeMessages.pushUnique("raccoonDown4")>>
					<br><br>
				<</if>>
			<<case 6>>
				<<if $raccoonbuild lt 30>>
					<<run $timeMessages.pushUnique("raccoonDown5")>>
					<<set $raccoon to 5>>
					<<set $transformationParts.raccoon.tail to "disabled">>
					<<set $hastail to "false">>
					<<set $thicktail to "false">>
					<br><br>
					<<set $permanentTransform to 1>>
				<</if>>
			<<case 99>>
				<<set $physicalTransform to 0>>
				<<set $raccoon to 0>>
				<<set $raccoonbuild to 0>>
				<<set $transformationParts.raccoon.tail to "disabled">>
				<<set $hastail to "false">>
				<<set $thicktail to "false">>
				<<set $transformationParts.raccoon.ears to "disabled">>
				<<set $transformationParts.raccoon.mask to "disabled">>
				<<set $transformationParts.traits.sharpEyes to "disabled">>
				<<set $transformationParts.traits.incognito to "disabled">>
		<</switch>>
	<<else>>
		<<clearAnimalTransformations>>
		<<set $physicalTransform to 1>>
		<<set $permanentTransform to 1>>
		<<set $raccoontf to 1>>
		<<set $raccoon to 6>>
		<<set $raccoonbuild to 100>>
		<<cleartail>>
		<<clearears>>
		<<clearcheeks>>
		<<set $transformationParts.traits.sharpEyes to "default">>
		<<set $transformationParts.traits.incognito to "default">>
		<<set $transformationParts.raccoon.tail to "default">>
		<<set $hastail to "true">>
		<<set $thintail to "true">>
		<<set $transformationParts.raccoon.ears to "default">>
		<<set $transformationParts.raccoon.mask to "default">>
	<</if>>
<</widget>>

<<widget "beeTransform">>
	<<if _args[0] gte 0>>
		<<switch _args[0]>>
			<<case 0>>
				<<if $beebuild gte 5 and $physicalTransform isnot 1>>
					<<set $physicalTransform to 1>>
					<<set $bee to 1>>
					<<run $timeMessages.pushUnique("beeUp1")>>
					<br><br>
				<</if>>
			<<case 1>>
