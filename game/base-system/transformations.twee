				<</if>>
			<<case 99>>
				<<set $physicalTransform to 0>>
				<<set $bee to 0>>
				<<set $beebuild to 0>>
				<<set $transformationParts.bee.tail to "disabled">>
				<<set $hastail to "false">>
				<<set $thicktail to "false">>
