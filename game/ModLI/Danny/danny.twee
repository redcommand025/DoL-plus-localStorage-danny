:: Danny Room Door
<<set _loc to getDannyLocation()>>
<<if _loc is "sleep">>
A note on the door: "Sleeping. Please don't wake me."
<<link [[Leave|Bedroom]]>><</link>>
<<elseif _loc is "work">>
A note: "At Niki's photography. Back later."
<<link [[Leave|Bedroom]]>><</link>>
<<elseif _loc is "school" or _loc is "walk" or _loc is "canteen" or _loc is "courtyard">>
A note: "At school. Back later."
<<link [[Leave|Bedroom]]>><</link>>
<<else>>
<<link [[Knock and enter|Danny Room]]>><</link>>
<<link [[Leave|Bedroom]]>><</link>>
<</if>>

:: Danny Room
You enter Danny's room. <<npc "Danny">>Danny looks up.
<<if $dannyIntro isnot 1>>
  <<set $dannyIntro to 1>>
  "H-hey... I'm Danny. I live here too."
  <<npcincr Danny love 3>>
<</if>>
<br>
<<if getDannyLocation() is "room">>
  <<link [[Talk|Danny Conversation]]>><<run DannyTalk.start()>><</link>>
  <br>
<<else>>
  <span class="black">Danny is about to head out, so there's no time for a proper talk.</span>
  <br>
<</if>>
<<link [[Work on science schoolwork|Danny Room]]>><<npcincr Danny love 2>><</link>>
<br>
<<link [[Buy a new camera for them|Danny Room]]>><<npcincr Danny love 5>><</link>>
<br>
<<link [[Help with control training|Danny Room]]>><<set $danny.control += 5>><<npcincr Danny love 3>><</link>>
<br>
<<link [[Offer dependency care|Danny Room]]>><<set $danny.dependency += 5>><<npcincr Danny love 4>><</link>>
<br>
<<if Time.isWeekEnd()>>
  <<link [[Go somewhere together|Danny Outings]]>><</link>>
  <br>
<</if>>
<<if $dannyAccidentKnown is 1>>
  <<link [[Give diapers|Danny Room]]>><<npcincr Danny acceptance 5>><</link>>
  <br>
<</if>>
<<if C.npc.Danny.love gte 50>>
  <<link [[Hug|Danny Room]]>><<npcincr Danny love 2>><</link>>
  <br>
<</if>>
<<if V.loveInterest and V.loveInterest.primary is "Danny">>
  <<link [[Cuddle|Danny Room]]>><<npcincr Danny love 3>><</link>>
  <br>
  <<link [[Kiss|Danny Room]]>><<npcincr Danny love 4>><</link>>
  <br>
<</if>>
<<if $promiscuity gte 2>>
  <<link [[Flirt|Danny Room]]>><<npcincr Danny lust 3>><</link>>
  <br>
<</if>>
<<link [[Leave|Bedroom]]>><</link>>

:: Danny Conversation
<<set _dtNode to DannyTalk.node($dannyTalkTree, $dannyTalkNode)>>
<<if !_dtNode>>
	Danny's attention drifts back to <<nnpc_his "Danny">> camera, and the conversation fizzles out.
	<br><br>
	<<link [[Back to Danny's room|Danny Room]]>><<run DannyTalk.finish()>><</link>>
<<else>>
	<<if $dannyTalkNode is "0">><<pass 1>><<else>><<pass 2>><</if>>
	<<print DannyTalk.text($dannyTalkTree, $dannyTalkNode)>>
	<<print DannyTalk.fx($dannyTalkTree, $dannyTalkNode)>>
	<br><br>
	<<set _dtOpts to DannyTalk.options($dannyTalkTree, $dannyTalkNode)>>
	<<if _dtOpts.length gt 0>>
		<<for _dtI to 0; _dtI lt _dtOpts.length; _dtI++>>
			<<capture _dtI, _dtOpts>>
				<<print (_dtI + 1) + ".">> <<link _dtOpts[_dtI].label "Danny Conversation">><<set $dannyTalkNode to _dtOpts[_dtI].to>><</link>>
				<br>
			<</capture>>
		<</for>>
	<<else>>
		<<link [[Back to Danny's room|Danny Room]]>><<run DannyTalk.finish()>><</link>>
	<</if>>
<</if>>

:: Danny Event
<<set _deId to $dannyEv and $dannyEv.id>>
<<if !_deId or !DannyEvents.event(_deId)>>
	Danny has already gone.
	<br><br>
	<<set _deRet to DannyEvents.finish()>>
	<<link "Continue" _deRet>><</link>>
<<else>>
	<<set $dannyEv.node to DannyEvents.resolve(_deId, $dannyEv.node) or "0">>
	<<pass 1>>
	<<print DannyEvents.text(_deId, $dannyEv.node)>>
	<<print DannyEvents.fx(_deId, $dannyEv.node)>>
	<br><br>
	<<set _deOpts to DannyEvents.options(_deId, $dannyEv.node)>>
	<<if _deOpts.length gt 0>>
		<<for _deI to 0; _deI lt _deOpts.length; _deI++>>
			<<capture _deI, _deOpts>>
				<<print (_deI + 1) + ".">> <<link _deOpts[_deI].label "Danny Event">><<set $dannyEv.node to _deOpts[_deI].to>><</link>>
				<br>
			<</capture>>
		<</for>>
	<<else>>
		<<set _deRet to $dannyEv.ret or "Hallways">>
		<<link "Continue" _deRet>><<run DannyEvents.finish()>><</link>>
	<</if>>
<</if>>

:: Danny Outings
Where do you want to go?
<br>
<<if $dannyAccidentKnown is 1>>
  <<link [[Store for diapers|Danny Room]]>><</link>>
  <br>
  <<link [[Adult Store for diapers|Danny Room]]>><</link>>
  <br>
<</if>>
<<if C.npc.Danny.love gte 75>>
  <<link [[Photo shoot|Danny Room]]>><<npcincr Danny love 3>><</link>>
  <br>
<</if>>
<<link [[Back|Danny Room]]>><</link>>

:: Danny First Meeting Canteen
In the canteen Danny nearly bumps into you.
"S-sorry! I'm Danny. We both live at the orphanage, right?"
<<link [[Continue|Canteen]]>><<set $dannyIntro to 1>><</link>>

:: Widgets Danny [widget]
<<widget "dannyroom_link">>
  <<if getDannyLocation() is "sleep">>
    <<bedroomicon>><<link [[Danny's room (locked)|Danny Room Door]]>><<pass 1>><</link>>
  <<else>>
    <<bedroomicon>><<link [[Danny's room (0:01)|Danny Room Door]]>><<pass 1>><</link>>
  <</if>>
  <br>
<</widget>>

<<widget "gdannyacceptance">><<if !$settings.blindStatsEnabled>> | <span class="green">+ Danny's Acceptance</span><</if>><</widget>>

<<widget "ldannyacceptance">><<if !$settings.blindStatsEnabled>> | <span class="red">- Danny's Acceptance</span><</if>><</widget>>

<<widget "dannyForcedAcceptanceText">>
	<br><span class="red">Danny has shut you out of this part of <<nnpc_his "Danny">> life. (Forced Acceptance: failed)</span>
<</widget>>

/* <<dannyEvents "place">>: offer a Danny location event here if one is available and its daily roll hit.
   Returns to the current passage when the scene ends. See game/ModLI/Danny/events/engine.js. */
<<widget "dannyEvents">>
	<<set _dannyEventShown to false>>
	<<if $exposed lte 0 and $stress lt $stressmax and !$possessed and window.DannyEvents>>
		<<set _dEv to DannyEvents.pick(_args[0])>>
		<<if _dEv>>
			<<set _dannyEventShown to true>>
			<<set _dEvLabel to DannyEvents.link(_dEv.id)>>
			<span class="teal"><<print DannyEvents.teaser(_dEv.id)>></span>
			<br>
			<<capture _dEv, _dEvLabel>>
				<<socialiseicon>><<link _dEvLabel "Danny Event">><<run DannyEvents.begin(_dEv.id, passage())>><</link>>
			<</capture>>
			<br><br>
		<</if>>
	<</if>>
<</widget>>

<<widget "dannyPresence">>
	<<if getDannyLocation() is _args[0]>>
		You see Danny here.
		<br>
	<</if>>
<</widget>>

:: Widgets Danny Init [widget]
<<widget "dannyInit">>
	<<if C.npc.Danny>>
		<<if C.npc.Danny.continence is undefined>>
			<<set C.npc.Danny.continence to 3000>>
		<</if>>
		<<if C.npc.Danny.acceptance is undefined>>
			<<set C.npc.Danny.acceptance to 200>>
		<</if>>
		<<set C.npc.Danny.continence to Math.clamp(C.npc.Danny.continence, 0, 6000)>>
		<<set C.npc.Danny.acceptance to Math.clamp(C.npc.Danny.acceptance, 0, 1000)>>
	<</if>>
<</widget>>
