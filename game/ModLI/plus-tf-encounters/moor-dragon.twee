<</if>>
<<effects>>
<<effectsman>>
<br>
<<beast $enemyno>>
<br><br>
<<stateman>>
<br><br>
<<actionsman>>
<<if $enemyarousal gte $enemyarousalmax>>
	<span id="next"><<link [[Next|Moor Dragon Rape End]]>><</link>></span><<nexttext>>
<<elseif $enemyhealth lte 0>>
	<span id="next"><<link [[Next|Moor Dragon Rape End]]>><</link>></span><<nexttext>>
<<else>>
	<span id="next"><<link [[Next|Moor Dragon Rape]]>><</link>></span><<nexttext>>
<</if>>

